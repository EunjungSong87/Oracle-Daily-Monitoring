# Copy this file to .env and fill in real values. .env is gitignored.

# App bind address (defaults to the hardcoded prod values in server.js if unset)
APP_HOST=localhost
APP_PORT=3000

# Metadata DB connection (monitoring_dbms_list / monitoring_tasks)
NODE_ORACLEDB_USER=system
NODE_ORACLEDB_PASSWORD=
NODE_ORACLEDB_CONNECTIONSTRING=localhost:1521/FREEPDB1

# AES-256-GCM key used to encrypt/decrypt target DBMS passwords.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Once set, do not change it without re-encrypting existing monitoring_dbms_list rows,
# or their passwords become permanently undecryptable.
DBMS_ENCRYPTION_KEY=

# Signs the login session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates all existing sessions (everyone gets logged out).
SESSION_SECRET=

# Target (monitored) DB timeouts. The metadata DB pool is not affected.
# Connect timeout in seconds, applied as Easy Connect Plus connect_timeout
# (transport_connect_timeout is min(5, this)). 0 = no limit.
TARGET_DB_CONNECT_TIMEOUT_SEC=10
# Per-call query timeouts (connection.callTimeout, ms). 0 = no limit.
# NOTE: in Thick mode (Instant Client 19) the actual wait is about 2x the value,
# so set half of the maximum wait you want.
# Daily monitoring tasks (actual wait ~60s)
TARGET_DB_CALL_TIMEOUT_MS=30000
# Real-Time polling / session detail (actual wait ~15s)
TARGET_DB_REALTIME_CALL_TIMEOUT_MS=7000
# "Test connection" button (actual wait ~10s)
TARGET_DB_TEST_CALL_TIMEOUT_MS=5000

# Data Pump: watch for jobs started outside the app (expdp/impdp) only on DBs whose
# Data Pump screen was opened within this many minutes (plus DBs with running jobs).
DATAPUMP_WATCH_MINUTES=30
