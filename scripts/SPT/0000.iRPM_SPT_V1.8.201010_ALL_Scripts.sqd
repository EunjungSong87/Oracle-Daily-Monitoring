-- =============================================================================================================================================
-- 수행중인 JOB 내역 보기
-- =============================================================================================================================================
SELECT * 
FROM DBA_SCHEDULER_JOBS 
WHERE JOB_NAME LIKE 'IRPMSPT%' 
ORDER BY JOB_NAME;

-- ==========================================================================================================================================   
-- SPT RUN Scheduler Job 강제종료 (STOP SCHEDULER JOB)
--   > 아래의 SQL을 실행해서 나온 RUN_CMD의 Script를 실행하여 JOB강제 종료
-- ========================================================================================================================================== 
-- ----------------------------------------------------------------------------------
-- RUN_NAME, RUN_SOURCE의 실행중인 대상을 전체 정리하기, 이 방법으로 처리 권장 
-- ----------------------------------------------------------------------------------
--EXEC IRPM_SPT.SPT_DROP_JOB(:RUN_NAME , :RUN_SOURCE, sys_context('USERENV', 'SESSION_USER'), 'ILM_IRPMSPT_RUN') ; 

SELECT 'BEGIN BEGIN DBMS_SCHEDULER.STOP_JOB(''' || JOB_NAME ||'''); EXCEPTION WHEN OTHERS THEN NULL; END;' ||
       '      BEGIN DBMS_SCHEDULER.DROP_JOB(''' || JOB_NAME ||'''); EXCEPTION WHEN OTHERS THEN NULL; END; END;' || chr(10) || '/' RUN_CMD 
FROM DBA_SCHEDULER_JOBS 
WHERE JOB_NAME LIKE 'IRPMSPT%'    
ORDER BY JOB_NAME DESC;

  
  
  
-- =============================================================================================================================================
-- SPT 수행로그 보기
-- =============================================================================================================================================
SELECT * 
FROM ILM_IRPMSPT_LOG_WORK 
ORDER BY 1 DESC;

select A.*, (select sql_text from dba_hist_sqltext h where h.SQL_ID = a.sql_id ) sql_text  
from ILM_IRPMSPT_RUN A 
where RUN_NAME like 'AWR_ALL_20190608132004';



-- =============================================================================================================================================
-- 부하발생기 JOB Start / Stop
-- =============================================================================================================================================
-- 실행방법 1) 다음의 경우는 즉시 부하발생기 Start하며 SPT_LOAD_STOP를 실행할 떄까지 지속적 실행
BEGIN iRPM_SPT.SPT_LOAD_START (:in_RUN_NAME, :in_RUN_SOURCE); END;
/

-- 실행방법 2) 다음의 경우는 1분뒤에 자동 START하며 10분간 부하 발생
BEGIN iRPM_SPT.SPT_LOAD_START (:in_RUN_NAME, :in_RUN_SOURCE, SYSDATE + 1/(24*60) , SYSDATE + 11/(24*60) ,'N' ); END;
/

-- 실행방법 3) 다음의 경우는 시간을 정확히 지정하여 실행 
BEGIN iRPM_SPT.SPT_LOAD_START (:in_RUN_NAME, :in_RUN_SOURCE, TO_DATE('2020-01-01 00:00:00','YYYY-MM-DD HH24:MI:SS') , TO_DATE('2020-01-01 00:30:00','YYYY-MM-DD HH24:MI:SS'), 'N'  ); END;
/

-- 실행방법 4) 다음의 경우는 시간을 정확히 지정하여 실행하며, 부하TEST시 Commit까지 처리  
BEGIN iRPM_SPT.SPT_LOAD_START (:in_RUN_NAME, :in_RUN_SOURCE, TO_DATE('2020-01-01 00:00:00','YYYY-MM-DD HH24:MI:SS') , TO_DATE('2020-01-01 00:30:00','YYYY-MM-DD HH24:MI:SS'), 'Y'  ); END;
/


-- 지정된 JOB_NAME 부하 발생 Stop
BEGIN iRPM_SPT.SPT_LOAD_STOP (:in_RUN_NAME, :in_RUN_SOURCE); END;
/

 
 
 
-- #############################################################################################################################################
--  
--  SPT 또는 부하발생기 실행동안 DB성능정보 Monitoring
--
--     --> "Host CPU Utilization (%)", "Logical Reads Per Sec"     ,"Physical Reads Per Sec"
--         "Executions Per Sec"      , "User Transaction Per Sec"  ,"Session Count"  
--     --> WITH MY_INPUT절의 값을 입력후 실행, 그대로 실행시 가장 최근에 시행한 JOB의 1번 Node의 DB성능 정보임
--     --> @@@@@@@@@@@@@@@@@  주의) 해당 Data는 최근 1시간 이전 성능정보만 보이므로 1시간 이내 수집 @@@@@@@@@@@@@@@@@@
--
-- #############################################################################################################################################

WITH MY_INPUT AS (
    SELECT
    
    --=====================================================================
    -- 아래의 3개의 값을 입력후 실행하세요~
    -- RAC 여러 Node의 DB성능정보를 확인하기 위해서는 INST_ID를 바꿔가면서 실행
    -- RUN_NAME, RUN_SOURCE가 NULL일 경우 가장 최근에 실행한 JOB의 값을 읽음
    --=====================================================================
    1                           INST_ID,
    NULL                        RUN_NAME,
    NULL                        RUN_SOURCE    
    --=====================================================================
    
    FROM DUAL 
)
,LAST_JOB AS (
    SELECT RUN_NAME, RUN_SOURCE
    FROM (SELECT RUN_NAME,RUN_SOURCE FROM ILM_IRPMSPT_RUNINFO 
          ORDER BY SUBSTR(RUN_NAME,-14) DESC)
    WHERE ROWNUM <= 1 
)
SELECT  INST_ID
       ,TO_CHAR(BEGIN_TIME,'YYYY-MM-DD HH24:MI')  "Snaptime"   
       ,ROUND(NVL(SUM(DECODE(METRIC_NAME,'Host CPU Utilization (%)' , VALUE)),0),1) "Host CPU Utilization (%)"
       ,ROUND(NVL(SUM(DECODE(METRIC_NAME,'Logical Reads Per Sec'    , VALUE)),0),1) "Logical Reads Per Sec"
       ,ROUND(NVL(SUM(DECODE(METRIC_NAME,'Physical Reads Per Sec'   , VALUE)),0),1) "Physical Reads Per Sec"
       ,ROUND(NVL(SUM(DECODE(METRIC_NAME,'Executions Per Sec'       , VALUE)),0),1) "Executions Per Sec"
       ,ROUND(NVL(SUM(DECODE(METRIC_NAME,'User Transaction Per Sec' , VALUE)),0),1) "User Transaction Per Sec"
       ,ROUND(NVL(SUM(DECODE(METRIC_NAME,'Session Count'            , VALUE)),0),1) "Session Count"  
  FROM (SELECT (RUN_START_DATE - (1/(24*60))) START_DATE , (NVL(RUN_END_DATE,SYSDATE) + (1/(24*60))) END_DATE
        FROM ILM_IRPMSPT_RUNINFO 
        WHERE RUN_NAME   = NVL((SELECT RUN_NAME FROM MY_INPUT),(SELECT RUN_NAME FROM LAST_JOB)) 
          AND RUN_SOURCE LIKE NVL((SELECT RUN_SOURCE FROM MY_INPUT),(SELECT RUN_SOURCE FROM LAST_JOB)) || '%'
       ) A,
       SYS.GV_$SYSMETRIC_HISTORY B
 WHERE 1=1 
   AND INST_ID    = (SELECT INST_ID FROM MY_INPUT)
   AND GROUP_ID   = 2   
   AND METRIC_NAME IN ('Host CPU Utilization (%)','Logical Reads Per Sec','Physical Reads Per Sec',
                       'Executions Per Sec','User Transaction Per Sec','Session Count')
   AND BEGIN_TIME BETWEEN  START_DATE AND END_DATE
 GROUP BY INST_ID,TO_CHAR(BEGIN_TIME,'YYYY-MM-DD HH24:MI') ;
 


  
  


-- #############################################################################################################################################
--
-- ERROR Summary 와 ERROR 상세 SQL List 확인
-- 
--      구분	        오류 유형	                                                            의견
--      ----------- ------------------------------------------------------------------- --------------------------------------------------------
--      ORA-00001	> ORA-00001: 무결성 제약 조건(...)에 위배됩니다	                            ===>  INSERT의 시점 차이로 무시해도 됨
--      ORA-01400	> ORA-01400: NULL을 (...) 안에 삽입할 수 없습니다	                        ===>  SELECT절의 BIND등은 Capture안되어 나타나는 문제. 무시 
--      ORA-14552	> ORA-14552: 질의 안에 또는 DML 안에 DDL, 커밋 또는 롤백을 수행할 수 없습니다      ===>  Function등에 Autonomous Transaction문제. 무시
--      	          ORA-06512: "xxx.xxxxxxx",  000행		
--      	          ORA-16962: SQL 문이 자율 트랜잭션을 시작하려고 시도했습니다.		
--      ORA-00979	> ORA-00979: GROUP BY 표현식이 아닙니다.	                                ===>  CURSOR_SHARING=SIMILAR or FORCE에 의해 발생. 무시해도 됨
--      ORA-01722	> ORA-01722: 수치가 부적합합니다                                          ===>  Bind값 관련. 무식
--      ORA-01840	> ORA-01840: 입력된 값의 길이가 날짜 형식에 비해 부족합니다	                    ===>  Bind값 관련. 무식
--      ORA-02019	> ORA-02019: 원격 데이터베이스 접속을 위한 접속 기술자를 찾을 수 없습니다.          ===>  DB*Link접속 차단하고 실행 원인. 무시
--      ORA-04092	> ORA-04092: 트리거 안에 ROLLBACK를 할 수 없습니다                          ===>  Autonomous Transaction문제. 무시
--      	          ORA-06512: "xxx.xxxxxxxxx",  000행		
--      	          ORA-16962: SQL 문이 자율 트랜잭션을 시작하려고 시도했습니다.		
-- #############################################################################################################################################



WITH MY_INPUT AS (
    SELECT
    --=====================================================================
    -- 아래의 2개의 값을 입력후 실행하세요~
    -- RUN_NAME, RUN_SOURCE가 NULL일 경우 가장 최근에 실행한 JOB의 값을 읽음
    --=====================================================================
    NULL                        RUN_NAME,
    NULL                        RUN_SOURCE    
    --=====================================================================
    FROM DUAL 
)
,LAST_JOB AS (
    SELECT RUN_NAME, RUN_SOURCE
    FROM (SELECT RUN_NAME,RUN_SOURCE FROM ILM_IRPMSPT_RUNINFO 
          ORDER BY SUBSTR(RUN_NAME,-14) DESC)
    WHERE ROWNUM <= 1 
)
SELECT A.RUN_NAME,
       A.ERROR_STR                                                   "Error String",
       A.ERROR_CNT                                                   "Error Count",
       ROUND(DECODE(B.PROC_E,0,0,NULL,0,A.ERROR_CNT/B.PROC_E),4)*100 "Error Pct(%)",
       B.TOT_CNT                                                     "Tot SQL Count",
       B.PROC_E                                                      "Tot SQL Err Count", 
       ROUND(DECODE(B.TOT_CNT,0,0,NULL,0,B.PROC_E/B.TOT_CNT),4)*100  "Total Error Pct(%)",
       -- Comment
       CASE WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-00001' THEN 'INSERT의 시점 차이로 무시해도 됨'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-01008' THEN 'BIND변수 수집이 안된 대상 실행. (UPDATE SET절, SELECT List절, INSERT VALUES절등이 대상)'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-14552' THEN 'Function등에 Autonomous Transaction문제. 무시'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-16962' THEN 'Function등에 Autonomous Transaction문제. 무시'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-16962' THEN 'Autonomous Transaction문제. 무시(TRIGGER는 Disabel후 실행 권장)'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-01722' THEN 'Bind값 관련. 확인 및 무시'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-01840' THEN 'DATE,TIMESTAMP 대상에 문자열로 입력되었으나 NLS_DATE_FORMAT과 맞지 않음'
            WHEN SUBSTR(A.ERROR_STR,1,9) = 'ORA-02019' THEN 'DB*Link접속 차단하고 실행 원인. 무시(DB*Link는 제거 또는 원본 연결 방지후 실행)'
            ELSE ''
       END                                                           "Comment"       
FROM  (SELECT /*+ LEADING(A,B) USE_NL(A B) */ 
               A.RUN_NAME, A.RUN_SOURCE, 
               SUBSTR(EXEC_ERROR,1,INSTR(EXEC_ERROR,'[')-1) ERROR_STR,  
               COUNT(*) ERROR_CNT
        FROM  ILM_IRPMSPT_RUN A
        WHERE 1=1
          AND A.RUN_NAME   = NVL((SELECT RUN_NAME FROM MY_INPUT),(SELECT RUN_NAME FROM LAST_JOB))
          AND A.RUN_SOURCE LIKE NVL((SELECT RUN_SOURCE FROM MY_INPUT),(SELECT RUN_SOURCE FROM LAST_JOB)) || '%'
          AND A.RUN_PROC_YN IN ('E')
        GROUP BY A.RUN_NAME,A.RUN_SOURCE,SUBSTR(EXEC_ERROR,1,INSTR(EXEC_ERROR,'[')-1)
      ) A
     ,ILM_IRPMSPT_RUNINFO B
WHERE A.RUN_NAME   = B.RUN_NAME
  AND SUBSTR(A.RUN_SOURCE,1,3) = B.RUN_SOURCE
ORDER BY 1,3 DESC,2;


-- =============================================================================================================================================
-- ERROR 상세 List
-- 	
-- =============================================================================================================================================

WITH MY_INPUT AS (
    SELECT
    --=====================================================================
    -- 아래의 2개의 값을 입력후 실행하세요~
    -- RUN_NAME, RUN_SOURCE가 NULL일 경우 가장 최근에 실행한 JOB의 값을 읽음
    --=====================================================================
    NULL                        RUN_NAME,
    NULL                        RUN_SOURCE    
    --=====================================================================
    FROM DUAL 
)
,LAST_JOB AS (
    SELECT RUN_NAME, RUN_SOURCE
    FROM (SELECT RUN_NAME,RUN_SOURCE FROM ILM_IRPMSPT_RUNINFO 
          ORDER BY SUBSTR(RUN_NAME,-14) DESC)
    WHERE ROWNUM <= 1 
)
SELECT A.RUN_NAME,A.RUN_SOURCE,A.SQL_ID,  
       SUBSTR(EXEC_ERROR,1,INSTR(EXEC_ERROR,'[')-1) ERROR_STR,
       (select sql_text from dba_hist_sqltext where rowid = A.AWR_ROWID)  SQL_TEXT 
FROM ILM_IRPMSPT_RUN A 
WHERE RUN_NAME   = NVL((SELECT RUN_NAME FROM MY_INPUT),(SELECT RUN_NAME FROM LAST_JOB))
  AND RUN_SOURCE LIKE NVL((SELECT RUN_SOURCE FROM MY_INPUT),(SELECT RUN_SOURCE FROM LAST_JOB)) || '%'
  AND RUN_PROC_YN IN ('E')
ORDER BY 1;  
VAR=2
:in_RUN_NAME=0,
:in_RUN_SOURCE=0,
NAME=0020.COMPARE_SPT_Result_for_STS(STS.vs.EXEC).sql
STMT=415
-- ======================================================================================================================================
-- 0012.COMPARE_SPT_Result_for_STS(STS.vs.EXEC).sql 
-- [SCRIPT 0012 : iRPM SPT의 SQL실행결과 비교]
-- 
-- UGENS SPT 결과 비교하기
--
--    실행 완료된 결과를 비교 (수집 SQL성능정보 vs RUN정보)
-- 
--    > ILM_IRPMSPT_SQLSET_STAGE, ILM_IRPMSPT_RUN 2개의 Table은 분석 대상으로 수정하여 실행
--    > SELECT 또는 CTAS로 결과 생성
--    > 아래의 SQL로 분석 대상의 RUN_NAME을 찾아서 'XXXXXXXXXXXXXXXXXXXXXXXXXXXX' 부분 수정
--
--    > SQL1 : 통계분석 
--    > SQL2 : 개별SQL 상세 LIST
-- ======================================================================================================================================

-- --------------------------------------------------------------------------------------------------
-- 기존 실행정보 확인하여 분석 대상 RUN_NAME 선택 
-- --------------------------------------------------------------------------------------------------

SELECT RUN_NAME,RUN_SOURCE,DECODE(LOAD_TEST_YN,'Y','Load Tester','SPT') "Run Type", DESCRIPTION "Description",
       DECODE(RUN_END_DATE,NULL,DECODE(PROC_REST,0,'N/A','Running...'),'Finished') "Run Status",RUN_START_DATE "Job Start Date",RUN_END_DATE "Job End Date",
       TOT_CNT "Target SQL Cnt",PROC_FINISH "Finished SQL Cnt",PROC_REST "Rest SQL Cnt",PROC_PCT "Progress %",
       PROC_P "Running SQL Cnt",PROC_N "Not Run Yet ",PROC_T "Timeout SQL Cnt",PROC_E "Error SQL Cnt",PROC_S "Skip SQL Cnt",PROC_Y "Run OK Cnt",
       PROC_FINISH "Total Runned SQL Cnt", ROUND(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))) "Load Duration(Sec)",
       ROUND(DECODE(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60)),0,0,NULL,0,PROC_FINISH/((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))),2) TPS, 
       -- Configuration Information
       RUN_PROCESS,RUN_SQL_TIMEOUT,RUN_REMAP_STRING,
       RUN_REPLACE_SYSDATE,RUN_NLS_DATE_FORMAT,RUN_PRE_SQL,RUN_POST_SQL,PLAN_COMPARE_YN,PLAN_COMPARE_CHK_RUN_YN,
       USE_SQL_REPLACE,USE_BIND_REPLACE,
       LOAD_REG_DATE,LOAD_TEST_YN,LOAD_PROC_STATUS,LOAD_PROC_THINKTIME,LOAD_PROC_STARTTIME,LOAD_PROC_ENDTIME ,LOAD_PROC_COMMIT_YN,  LOAD_PROC_TYPE,
       USE_QUERY_RESULT_CHK , USE_QUERY_RESULT_LOGGING, USE_QUERY_RESULT_ROWLIMIT, USE_SQL_COMMENT, PREFETCH_COUNT   
FROM ILM_IRPMSPT_RUNINFO
WHERE 1=1
-- AND RUN_NAME like 'ORDERS%'
-- ORDER BY COALESCE(RUN_START_DATE,LOAD_REG_DATE) DESC;
ORDER BY SUBSTR(RUN_NAME,-14) DESC;



-- --------------------------------------------------------------------------------------------------
-- SQL1 : 통계분석
-- --------------------------------------------------------------------------------------------------

SELECT B_RUN_NAME || '.vs.' || A_RUN_NAME RUN_NAME,                                                                                                
       -- -------------------------------------------------------------                                                                            
       -- SQL실행대상, Error발생수, Error 율                                                                                                          
       -- -------------------------------------------------------------                                                                            
       COUNT(SQL_ID)                                                                                         "Total SQL Cnt",                    
       COUNT(DISTINCT SQL_ID)                                                                                "Unique SQL Cnt",                   
       SUM(DECODE(A_EXEC_ERROR,NULL,1,0))                                                                    "Run OK Cnt",                       
       SUM(DECODE(A_EXEC_ERROR,NULL,0,1))                                                                    "Run Error Cnt",                    
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(A_EXEC_ERROR,NULL,0,1))/COUNT(SQL_ID)),3)                   "Run Error Pct%",                   
       COUNT(DISTINCT PARSING_SCHEMA_NAME)                                                                   "Parsing Schema Cnt",               
       -- -------------------------------------------------------------                                                                            
       -- Plan 변경 통계 (주의. Table/Index구조가 바뀌는 경우는 Plan변경에 대한 Summary는 무의미 함)                                                       
       -- -------------------------------------------------------------                                                                            
       SUM(DECODE(PLAN_CHANGED,'N',1,0))                                                                     "Plan Unchange Cnt",                
       SUM(DECODE(PLAN_CHANGED,'Y',1,0))                                                                     "Plan Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'N',1,0))/COUNT(SQL_ID)),3)                    "Plan Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'Y',1,0))/COUNT(SQL_ID)),3)                    "Plan Change Pct%",   
       -- PLAN String
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))                          "Plan Str Unchange Cnt",                
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))                          "Plan Str Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))/COUNT(SQL_ID)),3)        "Plan Str Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))/COUNT(SQL_ID)),3)        "Plan Str Change Pct%",   
       
       -- -------------------------------------------------------------                                                                            
       -- Buffer I/O기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                           
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)                                                   "Buff Improved SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)                                                   "Buff Unchange SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)                                                   "Buff Regression SQL Cnt",          
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Improved SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Unchange SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Regression SQL Pct%",         
       ROUND(AVG(BUFFER_IO_GAPS),2)                                                                          "Buff Avg Gaps(Blocks)",            
       ROUND(AVG(BUFFER_IO_GAPS*ASIS_EXECUTIONS),2)                                                          "Buff Avg Gaps(Blocks)*Exec",       
       ROUND(MIN(BUFFER_IO_GAPS),2)                                                                          "Buff Min Gaps(Blocks)",            
       ROUND(MAX(BUFFER_IO_GAPS),2)                                                                          "Buff Max Gaps(Blocks)",            
       ROUND(AVG(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Improve Ratio",            
       ROUND(MIN(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Min Improve Ratio",        
       ROUND(MAX(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Max Improve Ratio",        
       -- -------------------------------------------------------------                                                                            
       -- Elapsed Time기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                         
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)                                                  "Elapsed Improved SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)                                                  "Elapsed Unchange SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)                                                  "Elapsed Regression SQL Cnt",       
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Improved SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Unchange SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Regression SQL Pct%",      
       ROUND(AVG(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Avg Gaps(Blocks)",         
       ROUND(AVG(ELAPSE_TIME_GAP*ASIS_EXECUTIONS),2)                                                         "Elapsed Avg Gaps(Blocks)*Exec",    
       ROUND(MIN(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Min Gaps(Blocks)",         
       ROUND(MAX(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Max Gaps(Blocks)"          
FROM
-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_NL(AA BB) ROWID(CC) STS_VS_EXEC */
       TRUNC(SYSDATE)                                 RUN_DATE,
       CC.NAME                                        RUN_INFO,
       'STS (Repository Table)'                       B_RUN_NAME,
       AA.RUN_NAME                                    A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       CC.SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0)*100,3)                                CPU_USAGE_RATIO,
       iRPM_SPT.GET_SQLPLAN_FROM_STS4(sys_context('USERENV', 'SESSION_USER'),'ILM_IRPMSPT_SQLSET_STAGE',CC.NAME,CC.SQL_ID ,CC.PLAN_HASH_VALUE,CC.CHILD_NUMBER)  B_PLAN,
       A_PLAN,
       iRPM_SPT.GET_SQLPLAN_FROM_STS_COMP2(sys_context('USERENV', 'SESSION_USER'),'ILM_IRPMSPT_SQLSET_STAGE',CC.NAME,CC.SQL_ID ,CC.PLAN_HASH_VALUE,CC.CHILD_NUMBER) B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       iRPM_SPT.GET_PLAN_STRING_HASH(iRPM_SPT.GET_SQLPLAN_FROM_STS_COMP2(sys_context('USERENV', 'SESSION_USER'),'ILM_IRPMSPT_SQLSET_STAGE',CC.NAME,CC.SQL_ID ,CC.PLAN_HASH_VALUE,CC.CHILD_NUMBER)) B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH,
       CC.PLAN_HASH_VALUE B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',CC.PLAN_HASH_VALUE,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) END BUFFER_IO_GAPS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P') THEN NULL ELSE round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) - A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)                  B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)                  ASIS_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.CPU_TIME,0)/CC.executions)/ 1000000),5)                      B_CPU_TIME,
       A_CPU_TIME,
       CC.EXECUTIONS B_EXECUTIONS,
       A_EXECUTIONS,
       CC.DISK_READS B_DISK_READS,
       A_DISK_READS,
       CAST(NULL AS NUMBER) B_USER_IO_TIME,
       A_USER_IO_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS B_ROWS_PROCESSED,
       AA.A_ROWS_PROCESSED  ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS ASIS_ROWS_PROCESSED,
       DECODE(CC.FETCHES,0,1,NULL,1,DECODE(CC.ROWS_PROCESSED,0,1,CEIL(CC.ROWS_PROCESSED/CC.FETCHES)))        B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS_2,
       A_BUFFER_GETS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)  B_ELAPSED_TIME_2,
       A_ELAPSED_TIME_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.DISK_READS,0)/CC.executions)),0) B_DISK_READS_2,
       A_DISK_READS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) B_ROWS_PROCESSED_2,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       CC.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME ,
       CC.CHILD_NUMBER ,
       CC.SQL_ID                   B_SPT_SQL_ID,
       CC.PLAN_HASH_VALUE          B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID               A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE      A_SPT_PLAN_HASH_VALUE,
       'Not Available'             QUERY_RESULT_COMP,
       CAST(NULL AS VARCHAR2(100)) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1)        A_QUERY_RESULT_SHA1,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PROFILE,
       AA.SQL_PROFILE              A_SQL_PROFILE,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PATCH,
       AA.SQL_PATCH                A_SQL_PATCH,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE        A_SQL_PLAN_BASELINE,
       CAST(NULL AS VARCHAR2(100)) B_EXEC_ERROR,
       AA.EXEC_ERROR               A_EXEC_ERROR
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,NAME
           ,ID
           ,OWNER
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR
           ,INSTANCE_NUMBER
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE
           ,RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME   = '@@RUNNAME_AFTER@@'
      AND RUN_SOURCE = 'STS'
    ) AA,
    ILM_IRPMSPT_SQLSET_STAGE CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE AA.NAME      = CC.NAME
  AND AA.ID        = CC.ID
  AND AA.OWNER     = CC.OWNER
  AND AA.SQL_ID    = CC.SQL_ID
  AND AA.STS_ROWID = CC.ROWID
  AND CC.PARSING_SCHEMA_NAME IS NOT NULL
  AND AA.SQL_ID    = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID    = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
GROUP BY B_RUN_NAME || '.vs.' || A_RUN_NAME; 


-- --------------------------------------------------------------------------------------------------
-- SQL2 : 개별SQL 상세 LIST
-- --------------------------------------------------------------------------------------------------

SELECT QQ.*
FROM (SELECT ROW_NUMBER() OVER(ORDER BY ASIS_EXECUTIONS DESC) SEQ, RUN_DATE, RUN_INFO, B_RUN_NAME, A_RUN_NAME, SQL_ID, ASIS_EXECUTIONS, IO_IMPROVE_RATIO, IO_IMPACT_ESTIMATE, BUFFER_IO_GAPS,
       B_BUFFER_GETS, A_BUFFER_GETS, ASIS_BUFFER_GETS, PARSING_SCHEMA_NAME, MODULE, SQL_TEXT, CPU_USAGE_RANK, CPU_USAGE_RATIO, B_PLAN, A_PLAN,
       B_PLAN_COMPARE,A_PLAN_COMPARE, B_PLAN_RUNTIME_COMP_HASH B_PLAN_STRING_HASH, A_PLAN_RUNTIME_COMP_HASH A_PLAN_STRING_HASH, 
       CASE WHEN  B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END   PLAN_STRING_CHANGED, 
       B_PLAN_HASH, A_PLAN_HASH, PLAN_CHANGED, ELAPSE_TIME_GAP, B_ELAPSED_TIME, A_ELAPSED_TIME,ASIS_ELAPSED_TIME,B_CPU_TIME, A_CPU_TIME,
       B_EXECUTIONS, A_EXECUTIONS, B_DISK_READS, A_DISK_READS, B_USER_IO_TIME, A_USER_IO_TIME, B_ROWS_PROCESSED, A_ROWS_PROCESSED  , ASIS_ROWS_PROCESSED, B_PREFETCH_CNT,
       A_PREFETCH_CNT,  B_BUFFER_GETS_2 ,A_BUFFER_GETS_2 ,B_ELAPSED_TIME_2,A_ELAPSED_TIME_2 , B_DISK_READS_2, A_DISK_READS_2 , B_ROWS_PROCESSED_2, A_ROWS_PROCESSED_2 , BIND_VALUE,ELAPSED_TIME,
       CPU_TIME, BUFFER_GETS, DIRECT_WRITES, FETCHES, COMMAND_TYPE, FORCE_MATCHING_SIGNATURE, FIRST_LOAD_TIME ,CHILD_NUMBER, B_SPT_SQL_ID, B_SPT_PLAN_HASH_VALUE,
       A_SPT_SQL_ID, A_SPT_PLAN_HASH_VALUE, QUERY_RESULT_COMP, B_QUERY_RESULT_SHA1, A_QUERY_RESULT_SHA1, B_SQL_PROFILE, A_SQL_PROFILE, B_SQL_PATCH,
       A_SQL_PATCH, B_SQL_PLAN_BASELINE, A_SQL_PLAN_BASELINE, SQL_PLAN_BASELINE_YN, SQL_PROFILS_YN, COUNT(*) OVER() TOT_COUNT , B_EXEC_ERROR, A_EXEC_ERROR
FROM

-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_NL(AA BB) ROWID(CC) STS_VS_EXEC */
       TRUNC(SYSDATE)                                 RUN_DATE,
       CC.NAME                                        RUN_INFO,
       'STS (Repository Table)'                       B_RUN_NAME,
       AA.RUN_NAME                                    A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       CC.SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0)*100,3)                                CPU_USAGE_RATIO,
       iRPM_SPT.GET_SQLPLAN_FROM_STS4(sys_context('USERENV', 'SESSION_USER'),'ILM_IRPMSPT_SQLSET_STAGE',CC.NAME,CC.SQL_ID ,CC.PLAN_HASH_VALUE,CC.CHILD_NUMBER)  B_PLAN,
       A_PLAN,
       iRPM_SPT.GET_SQLPLAN_FROM_STS_COMP2(sys_context('USERENV', 'SESSION_USER'),'ILM_IRPMSPT_SQLSET_STAGE',CC.NAME,CC.SQL_ID ,CC.PLAN_HASH_VALUE,CC.CHILD_NUMBER) B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       iRPM_SPT.GET_PLAN_STRING_HASH(iRPM_SPT.GET_SQLPLAN_FROM_STS_COMP2(sys_context('USERENV', 'SESSION_USER'),'ILM_IRPMSPT_SQLSET_STAGE',CC.NAME,CC.SQL_ID ,CC.PLAN_HASH_VALUE,CC.CHILD_NUMBER)) B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH,
       CC.PLAN_HASH_VALUE B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',CC.PLAN_HASH_VALUE,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) END BUFFER_IO_GAPS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P') THEN NULL ELSE round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) - A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)                  B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)                  ASIS_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.CPU_TIME,0)/CC.executions)/ 1000000),5)                      B_CPU_TIME,
       A_CPU_TIME,
       CC.EXECUTIONS B_EXECUTIONS,
       A_EXECUTIONS,
       CC.DISK_READS B_DISK_READS,
       A_DISK_READS,
       CAST(NULL AS NUMBER) B_USER_IO_TIME,
       A_USER_IO_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS B_ROWS_PROCESSED,
       AA.A_ROWS_PROCESSED  ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS ASIS_ROWS_PROCESSED,
       DECODE(CC.FETCHES,0,1,NULL,1,DECODE(CC.ROWS_PROCESSED,0,1,CEIL(CC.ROWS_PROCESSED/CC.FETCHES)))        B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS_2,
       A_BUFFER_GETS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)  B_ELAPSED_TIME_2,
       A_ELAPSED_TIME_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.DISK_READS,0)/CC.executions)),0) B_DISK_READS_2,
       A_DISK_READS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) B_ROWS_PROCESSED_2,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       CC.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME ,
       CC.CHILD_NUMBER ,
       CC.SQL_ID                   B_SPT_SQL_ID,
       CC.PLAN_HASH_VALUE          B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID               A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE      A_SPT_PLAN_HASH_VALUE,
       'Not Available'             QUERY_RESULT_COMP,
       CAST(NULL AS VARCHAR2(100)) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1)        A_QUERY_RESULT_SHA1,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PROFILE,
       AA.SQL_PROFILE              A_SQL_PROFILE,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PATCH,
       AA.SQL_PATCH                A_SQL_PATCH,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE        A_SQL_PLAN_BASELINE,
       CAST(NULL AS VARCHAR2(100)) B_EXEC_ERROR,
       AA.EXEC_ERROR               A_EXEC_ERROR
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,NAME
           ,ID
           ,OWNER
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR
           ,INSTANCE_NUMBER
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE
           ,RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME   = '@@RUNNAME_AFTER@@'
      AND RUN_SOURCE = 'STS'
    ) AA,
    ILM_IRPMSPT_SQLSET_STAGE CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE AA.NAME      = CC.NAME
  AND AA.ID        = CC.ID
  AND AA.OWNER     = CC.OWNER
  AND AA.SQL_ID    = CC.SQL_ID
  AND AA.STS_ROWID = CC.ROWID
  AND CC.PARSING_SCHEMA_NAME IS NOT NULL
  AND AA.SQL_ID    = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID    = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
) QQ
ORDER BY ASIS_EXECUTIONS DESC;
VAR=2
:FINDREMAPSTR=0,
:REPLACEREMAPSTR=0,
NAME=0021.COMPARE_SPT_Result_for_STS(EXEC.vs.EXEC).sql
STMT=483
-- ======================================================================================================================================
-- 0013.COMPARE_SPT_Result_for_STS(EXEC.vs.EXEC).sql 
-- [SCRIPT 0013 : iRPM SPT의 SQL실행결과끼리 비교]
-- 
-- UGENS SPT 결과 비교하기
--
--    실행 완료된 결과를 비교 (수집 SQL성능정보 vs RUN정보)
-- 
--    > ILM_IRPMSPT_RUN vs ILM_IRPMSPT_RUN 2개의 RUN 실행 정보를 찾아서 아래 RUN_NAME 2곳(BEFORE_RUN_NAME,AFTER_RUN_NAME) 수정하여 비교
--
--    > SQL1 : 통계분석 
--    > SQL2 : 개별SQL 상세 LIST
-- ======================================================================================================================================

-- --------------------------------------------------------------------------------------------------
-- 기존 실행정보 확인하여 분석 대상 RUN_NAME 선택 
-- --------------------------------------------------------------------------------------------------

SELECT RUN_NAME,RUN_SOURCE,DECODE(LOAD_TEST_YN,'Y','Load Tester','SPT') "Run Type", DESCRIPTION "Description",
       DECODE(RUN_END_DATE,NULL,DECODE(PROC_REST,0,'N/A','Running...'),'Finished') "Run Status",RUN_START_DATE "Job Start Date",RUN_END_DATE "Job End Date",
       TOT_CNT "Target SQL Cnt",PROC_FINISH "Finished SQL Cnt",PROC_REST "Rest SQL Cnt",PROC_PCT "Progress %",
       PROC_P "Running SQL Cnt",PROC_N "Not Run Yet ",PROC_T "Timeout SQL Cnt",PROC_E "Error SQL Cnt",PROC_S "Skip SQL Cnt",PROC_Y "Run OK Cnt",
       PROC_FINISH "Total Runned SQL Cnt", ROUND(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))) "Load Duration(Sec)",
       ROUND(DECODE(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60)),0,0,NULL,0,PROC_FINISH/((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))),2) TPS, 
       -- Configuration Information
       RUN_PROCESS,RUN_SQL_TIMEOUT,RUN_REMAP_STRING,
       RUN_REPLACE_SYSDATE,RUN_NLS_DATE_FORMAT,RUN_PRE_SQL,RUN_POST_SQL,PLAN_COMPARE_YN,PLAN_COMPARE_CHK_RUN_YN,
       USE_SQL_REPLACE,USE_BIND_REPLACE,
       LOAD_REG_DATE,LOAD_TEST_YN,LOAD_PROC_STATUS,LOAD_PROC_THINKTIME,LOAD_PROC_STARTTIME,LOAD_PROC_ENDTIME ,LOAD_PROC_COMMIT_YN,  LOAD_PROC_TYPE,
       USE_QUERY_RESULT_CHK , USE_QUERY_RESULT_LOGGING, USE_QUERY_RESULT_ROWLIMIT, USE_SQL_COMMENT, PREFETCH_COUNT      
FROM ILM_IRPMSPT_RUNINFO
WHERE 1=1
-- AND RUN_NAME like 'ORDERS%'
-- ORDER BY COALESCE(RUN_START_DATE,LOAD_REG_DATE) DESC;
ORDER BY SUBSTR(RUN_NAME,-14) DESC;



-- --------------------------------------------------------------------------------------------------
-- SQL1 : 통계분석
-- --------------------------------------------------------------------------------------------------

SELECT B_RUN_NAME || '.vs.' || A_RUN_NAME RUN_NAME,                                                                                                
       -- -------------------------------------------------------------                                                                            
       -- SQL실행대상, Error발생수, Error 율                                                                                                          
       -- -------------------------------------------------------------                                                                            
       COUNT(SQL_ID)                                                                                         "Total SQL Cnt",                    
       COUNT(DISTINCT SQL_ID)                                                                                "Unique SQL Cnt",                   
       SUM(DECODE(A_EXEC_ERROR,NULL,1,0))                                                                    "Run OK Cnt",                       
       SUM(DECODE(A_EXEC_ERROR,NULL,0,1))                                                                    "Run Error Cnt",                    
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(A_EXEC_ERROR,NULL,0,1))/COUNT(SQL_ID)),3)                   "Run Error Pct%",                   
       COUNT(DISTINCT PARSING_SCHEMA_NAME)                                                                   "Parsing Schema Cnt",               
       -- -------------------------------------------------------------                                                                            
       -- Plan 변경 통계 (주의. Table/Index구조가 바뀌는 경우는 Plan변경에 대한 Summary는 무의미 함)                                                       
       -- -------------------------------------------------------------                                                                            
       SUM(DECODE(PLAN_CHANGED,'N',1,0))                                                                     "Plan Unchange Cnt",                
       SUM(DECODE(PLAN_CHANGED,'Y',1,0))                                                                     "Plan Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'N',1,0))/COUNT(SQL_ID)),3)                    "Plan Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'Y',1,0))/COUNT(SQL_ID)),3)                    "Plan Change Pct%",   
       -- PLAN String
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))                          "Plan Str Unchange Cnt",                
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))                          "Plan Str Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))/COUNT(SQL_ID)),3)        "Plan Str Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))/COUNT(SQL_ID)),3)        "Plan Str Change Pct%",   
       
       -- -------------------------------------------------------------                                                                            
       -- Buffer I/O기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                           
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)                                                   "Buff Improved SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)                                                   "Buff Unchange SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)                                                   "Buff Regression SQL Cnt",          
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Improved SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Unchange SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Regression SQL Pct%",         
       ROUND(AVG(BUFFER_IO_GAPS),2)                                                                          "Buff Avg Gaps(Blocks)",            
       ROUND(AVG(BUFFER_IO_GAPS*ASIS_EXECUTIONS),2)                                                          "Buff Avg Gaps(Blocks)*Exec",       
       ROUND(MIN(BUFFER_IO_GAPS),2)                                                                          "Buff Min Gaps(Blocks)",            
       ROUND(MAX(BUFFER_IO_GAPS),2)                                                                          "Buff Max Gaps(Blocks)",            
       ROUND(AVG(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Improve Ratio",            
       ROUND(MIN(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Min Improve Ratio",        
       ROUND(MAX(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Max Improve Ratio",        
       -- -------------------------------------------------------------                                                                            
       -- Elapsed Time기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                         
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)                                                  "Elapsed Improved SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)                                                  "Elapsed Unchange SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)                                                  "Elapsed Regression SQL Cnt",       
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Improved SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Unchange SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Regression SQL Pct%",      
       ROUND(AVG(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Avg Gaps(Blocks)",         
       ROUND(AVG(ELAPSE_TIME_GAP*ASIS_EXECUTIONS),2)                                                         "Elapsed Avg Gaps(Blocks)*Exec",    
       ROUND(MIN(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Min Gaps(Blocks)",         
       ROUND(MAX(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Max Gaps(Blocks)"          
FROM
-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_HASH(AA BB) USE_NL(CC) ROWID(CC) STS_EXEC_VS_EXEC */
       TRUNC(SYSDATE)                      RUN_DATE,
       CC.NAME                             RUN_INFO,
       BB.RUN_NAME                         B_RUN_NAME,
       AA.RUN_NAME                         A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       CC.SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0)*100,3)                                CPU_USAGE_RATIO,
       B_PLAN,
       A_PLAN,
       B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',B_PLAN_HASH,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE  CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE B_BUFFER_GETS - A_BUFFER_GETS  END BUFFER_IO_GAPS,
       B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0)                ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE B_ELAPSED_TIME - A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)      ASIS_ELAPSED_TIME,
       B_CPU_TIME,
       A_CPU_TIME,
       B_EXECUTIONS,
       A_EXECUTIONS,
       B_DISK_READS,
       A_DISK_READS,
       B_USER_IO_TIME,
       A_USER_IO_TIME,
       B_ROWS_PROCESSED,
       A_ROWS_PROCESSED,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0)             ASIS_ROWS_PROCESSED,
       B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       B_BUFFER_GETS_2 ,
       A_BUFFER_GETS_2 ,
       B_ELAPSED_TIME_2 ,
       A_ELAPSED_TIME_2 ,
       B_DISK_READS_2 ,
       A_DISK_READS_2 ,
       B_ROWS_PROCESSED_2 ,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       CC.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME ,
       CC.CHILD_NUMBER ,
       BB.SPT_SQL_ID           B_SPT_SQL_ID,
       BB.SPT_PLAN_HASH_VALUE  B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID           A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE  A_SPT_PLAN_HASH_VALUE,
       CASE WHEN BB.QUERY_RESULT_SHA1 IS NULL AND AA.QUERY_RESULT_SHA1 IS NULL THEN NULL
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Same'
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Not Same'
            ELSE NULL
       END QUERY_RESULT_COMP,
       UTL_RAW.CAST_TO_VARCHAR2(BB.QUERY_RESULT_SHA1) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1) A_QUERY_RESULT_SHA1,
       BB.SQL_PROFILE       B_SQL_PROFILE,
       AA.SQL_PROFILE       A_SQL_PROFILE,
       BB.SQL_PATCH         B_SQL_PATCH,
       AA.SQL_PATCH         A_SQL_PATCH,
       BB.SQL_PLAN_BASELINE B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE A_SQL_PLAN_BASELINE,
       B_EXEC_ERROR,
       A_EXEC_ERROR,
       B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,NAME
           ,ID
           ,OWNER
           ,PLAN_RUNTIME       B_PLAN
           ,PLAN_RUNTIME_COMP  B_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  B_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                B_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      B_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              B_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     B_USER_IO_TIME
           ,EXECUTIONS                                                                                B_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 B_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                B_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    B_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          B_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     B_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 B_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        B_PREFETCH_CNT
           ,EXEC_ERROR                                                                                B_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH B_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME   = '@@RUNNAME_BEFORE@@'
      AND RUN_SOURCE = 'STS'
    ) BB,
    (select
            y.RUN_NAME
           ,y.sql_id
           ,NAME
           ,ID
           ,OWNER
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR                                                                                A_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE , RUN_PROC_YN 
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME   = '@@RUNNAME_AFTER@@'
      AND RUN_SOURCE = 'STS'
    ) AA ,
    ILM_IRPMSPT_SQLSET_STAGE CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE AA.NAME      = BB.NAME
  AND AA.ID        = BB.ID
  AND AA.OWNER     = BB.OWNER
  AND AA.SQL_ID    = BB.SQL_ID
  AND AA.STS_ROWID = BB.STS_ROWID
  AND AA.STS_ROWID = CC.ROWID
  AND CC.PARSING_SCHEMA_NAME IS NOT NULL
  AND AA.SQL_ID    = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID    = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
GROUP BY B_RUN_NAME || '.vs.' || A_RUN_NAME; 



-- --------------------------------------------------------------------------------------------------
-- SQL2 : 개별SQL 상세 LIST
-- --------------------------------------------------------------------------------------------------

SELECT QQ.*
FROM (SELECT ROW_NUMBER() OVER(ORDER BY ASIS_EXECUTIONS DESC) SEQ, RUN_DATE, RUN_INFO, B_RUN_NAME, A_RUN_NAME, SQL_ID, ASIS_EXECUTIONS, IO_IMPROVE_RATIO, IO_IMPACT_ESTIMATE, BUFFER_IO_GAPS,
       B_BUFFER_GETS, A_BUFFER_GETS, ASIS_BUFFER_GETS, PARSING_SCHEMA_NAME, MODULE, SQL_TEXT, CPU_USAGE_RANK, CPU_USAGE_RATIO, B_PLAN, A_PLAN,
       B_PLAN_COMPARE,A_PLAN_COMPARE, B_PLAN_RUNTIME_COMP_HASH B_PLAN_STRING_HASH, A_PLAN_RUNTIME_COMP_HASH A_PLAN_STRING_HASH, 
       CASE WHEN  B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END   PLAN_STRING_CHANGED, 
       B_PLAN_HASH, A_PLAN_HASH, PLAN_CHANGED, ELAPSE_TIME_GAP, B_ELAPSED_TIME, A_ELAPSED_TIME,ASIS_ELAPSED_TIME,B_CPU_TIME, A_CPU_TIME,
       B_EXECUTIONS, A_EXECUTIONS, B_DISK_READS, A_DISK_READS, B_USER_IO_TIME, A_USER_IO_TIME, B_ROWS_PROCESSED, A_ROWS_PROCESSED  , ASIS_ROWS_PROCESSED, B_PREFETCH_CNT,
       A_PREFETCH_CNT,  B_BUFFER_GETS_2 ,A_BUFFER_GETS_2 ,B_ELAPSED_TIME_2,A_ELAPSED_TIME_2 , B_DISK_READS_2, A_DISK_READS_2 , B_ROWS_PROCESSED_2, A_ROWS_PROCESSED_2 , BIND_VALUE,ELAPSED_TIME,
       CPU_TIME, BUFFER_GETS, DIRECT_WRITES, FETCHES, COMMAND_TYPE, FORCE_MATCHING_SIGNATURE, FIRST_LOAD_TIME ,CHILD_NUMBER, B_SPT_SQL_ID, B_SPT_PLAN_HASH_VALUE,
       A_SPT_SQL_ID, A_SPT_PLAN_HASH_VALUE, QUERY_RESULT_COMP, B_QUERY_RESULT_SHA1, A_QUERY_RESULT_SHA1, B_SQL_PROFILE, A_SQL_PROFILE, B_SQL_PATCH,
       A_SQL_PATCH, B_SQL_PLAN_BASELINE, A_SQL_PLAN_BASELINE, SQL_PLAN_BASELINE_YN, SQL_PROFILS_YN, COUNT(*) OVER() TOT_COUNT , B_EXEC_ERROR, A_EXEC_ERROR
FROM
-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_HASH(AA BB) USE_NL(CC) ROWID(CC) STS_EXEC_VS_EXEC */
       TRUNC(SYSDATE)                      RUN_DATE,
       CC.NAME                             RUN_INFO,
       BB.RUN_NAME                         B_RUN_NAME,
       AA.RUN_NAME                         A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       CC.SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0)*100,3)                                CPU_USAGE_RATIO,
       B_PLAN,
       A_PLAN,
       B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',B_PLAN_HASH,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE  CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE B_BUFFER_GETS - A_BUFFER_GETS  END BUFFER_IO_GAPS,
       B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0)                ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE B_ELAPSED_TIME - A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)      ASIS_ELAPSED_TIME,
       B_CPU_TIME,
       A_CPU_TIME,
       B_EXECUTIONS,
       A_EXECUTIONS,
       B_DISK_READS,
       A_DISK_READS,
       B_USER_IO_TIME,
       A_USER_IO_TIME,
       B_ROWS_PROCESSED,
       A_ROWS_PROCESSED,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0)             ASIS_ROWS_PROCESSED,
       B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       B_BUFFER_GETS_2 ,
       A_BUFFER_GETS_2 ,
       B_ELAPSED_TIME_2 ,
       A_ELAPSED_TIME_2 ,
       B_DISK_READS_2 ,
       A_DISK_READS_2 ,
       B_ROWS_PROCESSED_2 ,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       CC.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME ,
       CC.CHILD_NUMBER ,
       BB.SPT_SQL_ID           B_SPT_SQL_ID,
       BB.SPT_PLAN_HASH_VALUE  B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID           A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE  A_SPT_PLAN_HASH_VALUE,
       CASE WHEN BB.QUERY_RESULT_SHA1 IS NULL AND AA.QUERY_RESULT_SHA1 IS NULL THEN NULL
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Same'
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Not Same'
            ELSE NULL
       END QUERY_RESULT_COMP,
       UTL_RAW.CAST_TO_VARCHAR2(BB.QUERY_RESULT_SHA1) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1) A_QUERY_RESULT_SHA1,
       BB.SQL_PROFILE       B_SQL_PROFILE,
       AA.SQL_PROFILE       A_SQL_PROFILE,
       BB.SQL_PATCH         B_SQL_PATCH,
       AA.SQL_PATCH         A_SQL_PATCH,
       BB.SQL_PLAN_BASELINE B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE A_SQL_PLAN_BASELINE,
       B_EXEC_ERROR,
       A_EXEC_ERROR,
       B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,NAME
           ,ID
           ,OWNER
           ,PLAN_RUNTIME       B_PLAN
           ,PLAN_RUNTIME_COMP  B_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  B_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                B_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      B_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              B_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     B_USER_IO_TIME
           ,EXECUTIONS                                                                                B_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 B_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                B_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    B_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          B_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     B_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 B_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        B_PREFETCH_CNT
           ,EXEC_ERROR                                                                                B_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH B_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME   = '@@RUNNAME_BEFORE@@'
      AND RUN_SOURCE = 'STS'
    ) BB,
    (select
            y.RUN_NAME
           ,y.sql_id
           ,NAME
           ,ID
           ,OWNER
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR                                                                                A_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE , RUN_PROC_YN 
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME   = '@@RUNNAME_AFTER@@'
      AND RUN_SOURCE = 'STS'
    ) AA ,
    ILM_IRPMSPT_SQLSET_STAGE CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE AA.NAME      = BB.NAME
  AND AA.ID        = BB.ID
  AND AA.OWNER     = BB.OWNER
  AND AA.SQL_ID    = BB.SQL_ID
  AND AA.STS_ROWID = BB.STS_ROWID
  AND AA.STS_ROWID = CC.ROWID
  AND CC.PARSING_SCHEMA_NAME IS NOT NULL
  AND AA.SQL_ID    = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID    = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
) QQ
ORDER BY ASIS_EXECUTIONS DESC ;


VAR=2
:FINDREMAPSTR=0,
:REPLACEREMAPSTR=0,
NAME=0022.COMPARE_SPT_Result_for_AWR(AWR.vs.EXEC).sql
STMT=494
-- ======================================================================================================================================
-- 0015.COMPARE_SPT_Result_for_AWR(AWR.vs.EXEC).sql 
-- [SCRIPT 0015 : iRPM SPT의 SQL실행결과 비교 - AWR Repository 사용 대상]
-- 
-- UGENS SPT 결과 비교하기
--
--    실행 완료된 결과를 비교 (수집 SQL성능정보 vs RUN정보)
-- 
--    > AWR Repository(DBA_HIST_SQLSTAT, DBA_HIST_SQLTEXT, DBA_HIST_SQL_PLAN)과 ILM_IRPMSPT_RUN 2개의 Table은 분석 대상으로 수정하여 실행
--    > 아래의 SQL로 분석 대상의 RUN_NAME을 찾아서  수정
--
--    > SQL1 : 통계분석 
--    > SQL2 : 개별SQL 상세 LIST
-- ======================================================================================================================================

-- --------------------------------------------------------------------------------------------------
-- 기존 실행정보 확인하여 분석 대상 RUN_NAME 선택 
-- --------------------------------------------------------------------------------------------------

SELECT RUN_NAME,RUN_SOURCE,DECODE(LOAD_TEST_YN,'Y','Load Tester','SPT') "Run Type", DESCRIPTION "Description",
       DECODE(RUN_END_DATE,NULL,DECODE(PROC_REST,0,'N/A','Running...'),'Finished') "Run Status",RUN_START_DATE "Job Start Date",RUN_END_DATE "Job End Date",
       TOT_CNT "Target SQL Cnt",PROC_FINISH "Finished SQL Cnt",PROC_REST "Rest SQL Cnt",PROC_PCT "Progress %",
       PROC_P "Running SQL Cnt",PROC_N "Not Run Yet ",PROC_T "Timeout SQL Cnt",PROC_E "Error SQL Cnt",PROC_S "Skip SQL Cnt",PROC_Y "Run OK Cnt",
       PROC_FINISH "Total Runned SQL Cnt", ROUND(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))) "Load Duration(Sec)",
       ROUND(DECODE(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60)),0,0,NULL,0,PROC_FINISH/((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))),2) TPS, 
       -- Configuration Information
       RUN_PROCESS,RUN_SQL_TIMEOUT,RUN_REMAP_STRING,
       RUN_REPLACE_SYSDATE,RUN_NLS_DATE_FORMAT,RUN_PRE_SQL,RUN_POST_SQL,PLAN_COMPARE_YN,PLAN_COMPARE_CHK_RUN_YN,
       USE_SQL_REPLACE,USE_BIND_REPLACE,
       LOAD_REG_DATE,LOAD_TEST_YN,LOAD_PROC_STATUS,LOAD_PROC_THINKTIME,LOAD_PROC_STARTTIME,LOAD_PROC_ENDTIME ,LOAD_PROC_COMMIT_YN,  LOAD_PROC_TYPE,
       USE_QUERY_RESULT_CHK , USE_QUERY_RESULT_LOGGING, USE_QUERY_RESULT_ROWLIMIT, USE_SQL_COMMENT, PREFETCH_COUNT      
FROM ILM_IRPMSPT_RUNINFO
WHERE 1=1
-- AND RUN_NAME like 'ORDERS%'
-- ORDER BY COALESCE(RUN_START_DATE,LOAD_REG_DATE) DESC;
ORDER BY SUBSTR(RUN_NAME,-14) DESC;





-- --------------------------------------------------------------------------------------------------
-- SQL1 : 통계분석
-- --------------------------------------------------------------------------------------------------

SELECT B_RUN_NAME || '.vs.' || A_RUN_NAME RUN_NAME,                                                                                                
       -- -------------------------------------------------------------                                                                            
       -- SQL실행대상, Error발생수, Error 율                                                                                                          
       -- -------------------------------------------------------------                                                                            
       COUNT(SQL_ID)                                                                                         "Total SQL Cnt",                    
       COUNT(DISTINCT SQL_ID)                                                                                "Unique SQL Cnt",                   
       SUM(DECODE(A_EXEC_ERROR,NULL,1,0))                                                                    "Run OK Cnt",                       
       SUM(DECODE(A_EXEC_ERROR,NULL,0,1))                                                                    "Run Error Cnt",                    
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(A_EXEC_ERROR,NULL,0,1))/COUNT(SQL_ID)),3)                   "Run Error Pct%",                   
       COUNT(DISTINCT PARSING_SCHEMA_NAME)                                                                   "Parsing Schema Cnt",               
       -- -------------------------------------------------------------                                                                            
       -- Plan 변경 통계 (주의. Table/Index구조가 바뀌는 경우는 Plan변경에 대한 Summary는 무의미 함)                                                       
       -- -------------------------------------------------------------                                                                            
       SUM(DECODE(PLAN_CHANGED,'N',1,0))                                                                     "Plan Unchange Cnt",                
       SUM(DECODE(PLAN_CHANGED,'Y',1,0))                                                                     "Plan Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'N',1,0))/COUNT(SQL_ID)),3)                    "Plan Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'Y',1,0))/COUNT(SQL_ID)),3)                    "Plan Change Pct%",   
       -- PLAN String
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))                          "Plan Str Unchange Cnt",                
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))                          "Plan Str Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))/COUNT(SQL_ID)),3)        "Plan Str Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))/COUNT(SQL_ID)),3)        "Plan Str Change Pct%",   
       
       -- -------------------------------------------------------------                                                                            
       -- Buffer I/O기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                           
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)                                                   "Buff Improved SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)                                                   "Buff Unchange SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)                                                   "Buff Regression SQL Cnt",          
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Improved SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Unchange SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Regression SQL Pct%",         
       ROUND(AVG(BUFFER_IO_GAPS),2)                                                                          "Buff Avg Gaps(Blocks)",            
       ROUND(AVG(BUFFER_IO_GAPS*ASIS_EXECUTIONS),2)                                                          "Buff Avg Gaps(Blocks)*Exec",       
       ROUND(MIN(BUFFER_IO_GAPS),2)                                                                          "Buff Min Gaps(Blocks)",            
       ROUND(MAX(BUFFER_IO_GAPS),2)                                                                          "Buff Max Gaps(Blocks)",            
       ROUND(AVG(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Improve Ratio",            
       ROUND(MIN(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Min Improve Ratio",        
       ROUND(MAX(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Max Improve Ratio",        
       -- -------------------------------------------------------------                                                                            
       -- Elapsed Time기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                         
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)                                                  "Elapsed Improved SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)                                                  "Elapsed Unchange SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)                                                  "Elapsed Regression SQL Cnt",       
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Improved SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Unchange SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Regression SQL Pct%",      
       ROUND(AVG(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Avg Gaps(Blocks)",         
       ROUND(AVG(ELAPSE_TIME_GAP*ASIS_EXECUTIONS),2)                                                         "Elapsed Avg Gaps(Blocks)*Exec",    
       ROUND(MIN(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Min Gaps(Blocks)",         
       ROUND(MAX(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Max Gaps(Blocks)"          
FROM
-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_NL(AA BB) ROWID(CC) AWR_VS_EXEC */
       TRUNC(SYSDATE)                      RUN_DATE,
       'AWR SPT'      RUN_INFO,
       'INST,AWR Snap: [' || TO_CHAR(AA.INSTANCE_NUMBER) ||','|| AA.MIN_SNAP_ID || ' ~ ' || AA.MAX_SNAP_ID || ']' B_RUN_NAME,
       AA.RUN_NAME                         A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       (select sql_text from dba_hist_sqltext where rowid = AWR_ROWID)  SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0),5)                                    CPU_USAGE_RATIO,
       iRPM_SPT.GET_SQLPLAN_HIST(AWR_PLAN_HASH_VALUE,AA.SQL_ID,AA.DBID )  B_PLAN,
       A_PLAN,
       iRPM_SPT.GET_SQLPLAN_HIST_COMP(AWR_PLAN_HASH_VALUE,AA.SQL_ID,AA.DBID) B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       iRPM_SPT.GET_PLAN_STRING_HASH(iRPM_SPT.GET_SQLPLAN_HIST_COMP(AWR_PLAN_HASH_VALUE,AA.SQL_ID,AA.DBID)) B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH,       
       CC.PLAN_HASH_VALUE B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',CC.PLAN_HASH_VALUE,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) END BUFFER_IO_GAPS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P') THEN NULL ELSE round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/1000000),5) -A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) ASIS_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.CPU_TIME,0)/CC.executions)/ 1000000),5)  B_CPU_TIME,
       A_CPU_TIME,
       CC.EXECUTIONS B_EXECUTIONS,
       A_EXECUTIONS,
       CC.DISK_READS B_DISK_READS,
       A_DISK_READS,
       CAST(NULL AS NUMBER) B_USER_IO_TIME,
       A_USER_IO_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS B_ROWS_PROCESSED,
       AA.A_ROWS_PROCESSED AS A_ROWS_PROCESSED,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS ASIS_ROWS_PROCESSED,
       B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS_2,
       A_BUFFER_GETS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) B_ELAPSED_TIME_2,
       A_ELAPSED_TIME_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.DISK_READS,0)/CC.executions)),0) B_DISK_READS_2,
       A_DISK_READS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) B_ROWS_PROCESSED_2,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       AA.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME ,
       CC.SQL_ID                   B_SPT_SQL_ID,
       CC.PLAN_HASH_VALUE          B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE A_SPT_PLAN_HASH_VALUE,
       'Not Available'             QUERY_RESULT_COMP,
       CAST(NULL AS VARCHAR2(100)) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1)        A_QUERY_RESULT_SHA1,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PROFILE,
       AA.SQL_PROFILE              A_SQL_PROFILE,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PATCH,
       AA.SQL_PATCH                A_SQL_PATCH,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE        A_SQL_PLAN_BASELINE,
       CAST(NULL AS VARCHAR2(100)) B_EXEC_ERROR,
       AA.EXEC_ERROR               A_EXEC_ERROR,
       NULL CHILD_NUMBER
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,MIN_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 Start Snap ID (윰_hist_snapshot)
           ,MAX_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 End Snap ID (dba_hist_snapshot)
           ,DBID                                 -- AWR Only : AWR Repository의 수집대상의 DBID (dba_hist_snapshot)
           ,INSTANCE_NUMBER                      -- AWR Only : AWR Repository의 수집대상의 INSTANCE_NUMBER (dba_hist_snapshot)
           ,AWR_PLAN_HASH_VALUE                  -- AWR Only : AWR Repository의 수집대상SQL의 PLAN_HASH_VALUE (dba_hist_sql_plan)
           ,AWR_ROWID                            -- AWR Only : AWR Repository의 수집대상SQL의 SQL TEXT의 ROWID (dba_hist_sqltext)
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE
           ,QUERY_RESULT_SHA1
           ,COMMAND_TYPE  , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME = '@@RUNNAME_AFTER@@'
      AND RUN_SOURCE like 'AWR%'
    ) AA,
    (select  /*+ LEADING(SN SY) NO_MERGE(SN) USE_HASH(SN SY) FULL(sy) */
              sy.dbid, sy.sql_id,sy.plan_hash_value
            , NVL(sum(ELAPSED_TIME_DELTA)           ,0) ELAPSED_TIME
            , NVL(sum(CPU_TIME_DELTA)               ,0) CPU_TIME
            , NVL(sum(EXECUTIONS_DELTA)             ,0) EXECUTIONS
            , NVL(sum(FETCHES_DELTA)                ,0) FETCHES
            , NVL(sum(END_OF_FETCH_COUNT_DELTA)     ,0) END_OF_FETCH_COUNT
            , NVL(sum(SORTS_DELTA)                  ,0) SORTS
            , NVL(sum(PX_SERVERS_EXECS_DELTA)       ,0) PX_SERVERS_EXECS
            , NVL(sum(LOADS_DELTA)                  ,0) LOADS
            , NVL(sum(INVALIDATIONS_DELTA)          ,0) INVALIDATIONS
            , NVL(sum(PARSE_CALLS_DELTA)            ,0) PARSE_CALLS
            , NVL(sum(DISK_READS_DELTA)             ,0) DISK_READS
            , NVL(sum(BUFFER_GETS_DELTA)            ,0) BUFFER_GETS
            , NVL(sum(ROWS_PROCESSED_DELTA)         ,0) ROWS_PROCESSED
            , NVL(sum(IOWAIT_DELTA)                 ,0) IOWAIT
            , NVL(sum(CLWAIT_DELTA)                 ,0) CLWAIT
            , NVL(sum(APWAIT_DELTA)                 ,0) APWAIT
            , NVL(sum(CCWAIT_DELTA)                 ,0) CCWAIT
            , NVL(sum(DIRECT_WRITES_DELTA)          ,0) DIRECT_WRITES
            , NVL(sum(PLSEXEC_TIME_DELTA)           ,0) PLSEXEC_TIME
            , NVL(sum(JAVEXEC_TIME_DELTA)           ,0) JAVEXEC_TIME
            , MAX(FORCE_MATCHING_SIGNATURE)             FORCE_MATCHING_SIGNATURE
            , MAX(MODULE)                               MODULE
            , MAX(PARSING_SCHEMA_NAME)                  PARSING_SCHEMA_NAME
            , MAX(BIND_DATA)                            BIND_DATA
            , MIN('SNAP_ID:' || SNAP_ID)                FIRST_LOAD_TIME
            , DECODE(sum(FETCHES_DELTA),0,1,NULL,1,DECODE(sum(ROWS_PROCESSED_DELTA),0,1,CEIL(sum(ROWS_PROCESSED_DELTA)/sum(FETCHES_DELTA))))        B_PREFETCH_CNT
      from  (SELECT DBID,INSTANCE_NUMBER,SQL_ID ,MIN_SNAP_ID ,MAX_SNAP_ID
            from   ILM_IRPMSPT_RUN y
            WHERE  RUN_NAME = '@@RUNNAME_AFTER@@'
              AND  RUN_SOURCE like 'AWR%'
            ) V1,
            dba_hist_sqlstat  sy
     WHERE  1=1
       and sy.snap_id         BETWEEN V1.MIN_SNAP_ID AND V1.MAX_SNAP_ID
       and sy.dbid            = V1.dbid
       and sy.instance_number = V1.instance_number
       and sy.sql_id          = V1.sql_id
     group by sy.dbid,sy.sql_id,sy.plan_hash_value) CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE 1=1
  AND AA.DBID      = CC.DBID
  AND AA.SQL_ID    = CC.SQL_ID
  AND AA.AWR_PLAN_HASH_VALUE = CC.PLAN_HASH_VALUE
  AND AA.SQL_ID    = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID    = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
GROUP BY B_RUN_NAME || '.vs.' || A_RUN_NAME; 




-- --------------------------------------------------------------------------------------------------
-- SQL2 : 개별SQL 상세 LIST
-- --------------------------------------------------------------------------------------------------

SELECT QQ.*
FROM (SELECT ROW_NUMBER() OVER(ORDER BY ASIS_EXECUTIONS DESC) SEQ, RUN_DATE, RUN_INFO, B_RUN_NAME, A_RUN_NAME, SQL_ID, ASIS_EXECUTIONS, IO_IMPROVE_RATIO, IO_IMPACT_ESTIMATE, BUFFER_IO_GAPS,
       B_BUFFER_GETS, A_BUFFER_GETS, ASIS_BUFFER_GETS, PARSING_SCHEMA_NAME, MODULE, SQL_TEXT, CPU_USAGE_RANK, CPU_USAGE_RATIO, B_PLAN, A_PLAN,
       B_PLAN_COMPARE,A_PLAN_COMPARE, B_PLAN_RUNTIME_COMP_HASH B_PLAN_STRING_HASH, A_PLAN_RUNTIME_COMP_HASH A_PLAN_STRING_HASH, 
       CASE WHEN  B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END   PLAN_STRING_CHANGED, 
       B_PLAN_HASH, A_PLAN_HASH, PLAN_CHANGED, ELAPSE_TIME_GAP, B_ELAPSED_TIME, A_ELAPSED_TIME,ASIS_ELAPSED_TIME,B_CPU_TIME, A_CPU_TIME,
       B_EXECUTIONS, A_EXECUTIONS, B_DISK_READS, A_DISK_READS, B_USER_IO_TIME, A_USER_IO_TIME, B_ROWS_PROCESSED, A_ROWS_PROCESSED  , ASIS_ROWS_PROCESSED, B_PREFETCH_CNT,
       A_PREFETCH_CNT,  B_BUFFER_GETS_2 ,A_BUFFER_GETS_2 ,B_ELAPSED_TIME_2,A_ELAPSED_TIME_2 , B_DISK_READS_2, A_DISK_READS_2 , B_ROWS_PROCESSED_2, A_ROWS_PROCESSED_2 , BIND_VALUE,ELAPSED_TIME,
       CPU_TIME, BUFFER_GETS, DIRECT_WRITES, FETCHES, COMMAND_TYPE, FORCE_MATCHING_SIGNATURE, FIRST_LOAD_TIME ,CHILD_NUMBER, B_SPT_SQL_ID, B_SPT_PLAN_HASH_VALUE,
       A_SPT_SQL_ID, A_SPT_PLAN_HASH_VALUE, QUERY_RESULT_COMP, B_QUERY_RESULT_SHA1, A_QUERY_RESULT_SHA1, B_SQL_PROFILE, A_SQL_PROFILE, B_SQL_PATCH,
       A_SQL_PATCH, B_SQL_PLAN_BASELINE, A_SQL_PLAN_BASELINE, SQL_PLAN_BASELINE_YN, SQL_PROFILS_YN, COUNT(*) OVER() TOT_COUNT , B_EXEC_ERROR, A_EXEC_ERROR
FROM
-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_NL(AA BB) ROWID(CC) AWR_VS_EXEC */
       TRUNC(SYSDATE)                      RUN_DATE,
       'AWR SPT'      RUN_INFO,
       'INST,AWR Snap: [' || TO_CHAR(AA.INSTANCE_NUMBER) ||','|| AA.MIN_SNAP_ID || ' ~ ' || AA.MAX_SNAP_ID || ']' B_RUN_NAME,
       AA.RUN_NAME                         A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       (select sql_text from dba_hist_sqltext where rowid = AWR_ROWID)  SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0),5)                                    CPU_USAGE_RATIO,
       iRPM_SPT.GET_SQLPLAN_HIST(AWR_PLAN_HASH_VALUE,AA.SQL_ID,AA.DBID )  B_PLAN,
       A_PLAN,
       iRPM_SPT.GET_SQLPLAN_HIST_COMP(AWR_PLAN_HASH_VALUE,AA.SQL_ID,AA.DBID) B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       iRPM_SPT.GET_PLAN_STRING_HASH(iRPM_SPT.GET_SQLPLAN_HIST_COMP(AWR_PLAN_HASH_VALUE,AA.SQL_ID,AA.DBID)) B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH,       
       CC.PLAN_HASH_VALUE B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',CC.PLAN_HASH_VALUE,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) > 0 THEN
               round(decode(round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0),0,0,
               round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/
               round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0))*100,2)),2)
            WHEN  (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE (round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) - A_BUFFER_GETS) END BUFFER_IO_GAPS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P') THEN NULL ELSE round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/1000000),5) -A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) ASIS_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.CPU_TIME,0)/CC.executions)/ 1000000),5)  B_CPU_TIME,
       A_CPU_TIME,
       CC.EXECUTIONS B_EXECUTIONS,
       A_EXECUTIONS,
       CC.DISK_READS B_DISK_READS,
       A_DISK_READS,
       CAST(NULL AS NUMBER) B_USER_IO_TIME,
       A_USER_IO_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS B_ROWS_PROCESSED,
       AA.A_ROWS_PROCESSED AS A_ROWS_PROCESSED,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) AS ASIS_ROWS_PROCESSED,
       B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0) B_BUFFER_GETS_2,
       A_BUFFER_GETS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5) B_ELAPSED_TIME_2,
       A_ELAPSED_TIME_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.DISK_READS,0)/CC.executions)),0) B_DISK_READS_2,
       A_DISK_READS_2 ,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0) B_ROWS_PROCESSED_2,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       AA.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME ,
       CC.SQL_ID                   B_SPT_SQL_ID,
       CC.PLAN_HASH_VALUE          B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE A_SPT_PLAN_HASH_VALUE,
       'Not Available'             QUERY_RESULT_COMP,
       CAST(NULL AS VARCHAR2(100)) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1)        A_QUERY_RESULT_SHA1,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PROFILE,
       AA.SQL_PROFILE              A_SQL_PROFILE,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PATCH,
       AA.SQL_PATCH                A_SQL_PATCH,
       CAST(NULL AS VARCHAR2(100)) B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE        A_SQL_PLAN_BASELINE,
       CAST(NULL AS VARCHAR2(100)) B_EXEC_ERROR,
       AA.EXEC_ERROR               A_EXEC_ERROR,
       NULL CHILD_NUMBER
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,MIN_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 Start Snap ID (윰_hist_snapshot)
           ,MAX_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 End Snap ID (dba_hist_snapshot)
           ,DBID                                 -- AWR Only : AWR Repository의 수집대상의 DBID (dba_hist_snapshot)
           ,INSTANCE_NUMBER                      -- AWR Only : AWR Repository의 수집대상의 INSTANCE_NUMBER (dba_hist_snapshot)
           ,AWR_PLAN_HASH_VALUE                  -- AWR Only : AWR Repository의 수집대상SQL의 PLAN_HASH_VALUE (dba_hist_sql_plan)
           ,AWR_ROWID                            -- AWR Only : AWR Repository의 수집대상SQL의 SQL TEXT의 ROWID (dba_hist_sqltext)
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE
           ,QUERY_RESULT_SHA1
           ,COMMAND_TYPE  , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME = '@@RUNNAME_AFTER@@'
      AND RUN_SOURCE like 'AWR%'
    ) AA,
    (select  /*+ LEADING(SN SY) NO_MERGE(SN) USE_HASH(SN SY) FULL(sy) */
              sy.dbid, sy.sql_id,sy.plan_hash_value
            , NVL(sum(ELAPSED_TIME_DELTA)           ,0) ELAPSED_TIME
            , NVL(sum(CPU_TIME_DELTA)               ,0) CPU_TIME
            , NVL(sum(EXECUTIONS_DELTA)             ,0) EXECUTIONS
            , NVL(sum(FETCHES_DELTA)                ,0) FETCHES
            , NVL(sum(END_OF_FETCH_COUNT_DELTA)     ,0) END_OF_FETCH_COUNT
            , NVL(sum(SORTS_DELTA)                  ,0) SORTS
            , NVL(sum(PX_SERVERS_EXECS_DELTA)       ,0) PX_SERVERS_EXECS
            , NVL(sum(LOADS_DELTA)                  ,0) LOADS
            , NVL(sum(INVALIDATIONS_DELTA)          ,0) INVALIDATIONS
            , NVL(sum(PARSE_CALLS_DELTA)            ,0) PARSE_CALLS
            , NVL(sum(DISK_READS_DELTA)             ,0) DISK_READS
            , NVL(sum(BUFFER_GETS_DELTA)            ,0) BUFFER_GETS
            , NVL(sum(ROWS_PROCESSED_DELTA)         ,0) ROWS_PROCESSED
            , NVL(sum(IOWAIT_DELTA)                 ,0) IOWAIT
            , NVL(sum(CLWAIT_DELTA)                 ,0) CLWAIT
            , NVL(sum(APWAIT_DELTA)                 ,0) APWAIT
            , NVL(sum(CCWAIT_DELTA)                 ,0) CCWAIT
            , NVL(sum(DIRECT_WRITES_DELTA)          ,0) DIRECT_WRITES
            , NVL(sum(PLSEXEC_TIME_DELTA)           ,0) PLSEXEC_TIME
            , NVL(sum(JAVEXEC_TIME_DELTA)           ,0) JAVEXEC_TIME
            , MAX(FORCE_MATCHING_SIGNATURE)             FORCE_MATCHING_SIGNATURE
            , MAX(MODULE)                               MODULE
            , MAX(PARSING_SCHEMA_NAME)                  PARSING_SCHEMA_NAME
            , MAX(BIND_DATA)                            BIND_DATA
            , MIN('SNAP_ID:' || SNAP_ID)                FIRST_LOAD_TIME
            , DECODE(sum(FETCHES_DELTA),0,1,NULL,1,DECODE(sum(ROWS_PROCESSED_DELTA),0,1,CEIL(sum(ROWS_PROCESSED_DELTA)/sum(FETCHES_DELTA))))        B_PREFETCH_CNT
      from  (SELECT DBID,INSTANCE_NUMBER,SQL_ID ,MIN_SNAP_ID ,MAX_SNAP_ID
            from   ILM_IRPMSPT_RUN y
            WHERE  RUN_NAME = '@@RUNNAME_AFTER@@'
              AND  RUN_SOURCE like 'AWR%'
            ) V1,
            dba_hist_sqlstat  sy
     WHERE  1=1
       and sy.snap_id         BETWEEN V1.MIN_SNAP_ID AND V1.MAX_SNAP_ID
       and sy.dbid            = V1.dbid
       and sy.instance_number = V1.instance_number
       and sy.sql_id          = V1.sql_id
     group by sy.dbid,sy.sql_id,sy.plan_hash_value) CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE 1=1
  AND AA.DBID      = CC.DBID
  AND AA.SQL_ID    = CC.SQL_ID
  AND AA.AWR_PLAN_HASH_VALUE = CC.PLAN_HASH_VALUE
  AND AA.SQL_ID    = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID    = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
 
) QQ
ORDER BY ASIS_EXECUTIONS DESC ;
VAR=0
NAME=0023.COMPARE_SPT_Result_for_AWR(EXEC.vs.EXEC).sql
STMT=585
-- ======================================================================================================================================
-- 0016.COMPARE_SPT_Result_for_AWR(EXEC.vs.EXEC).sql 
-- [SCRIPT 0016 : iRPM SPT의 SQL실행결과 비교 - AWR Repository 사용 대상]
-- 
-- UGENS SPT 결과 비교하기
--
--    실행 완료된 결과를 비교 (수집 SQL성능정보 vs RUN정보)
-- 
--    > AWR Repository(DBA_HIST_SQLSTAT, DBA_HIST_SQLTEXT, DBA_HIST_SQL_PLAN)과 ILM_IRPMSPT_RUN 2개의 Table은 분석 대상으로 수정하여 실행
--    > 아래의 SQL로 분석 대상의 RUN_NAME을 찾아서  수정
--
--    > SQL1 : 통계분석 
--    > SQL2 : 개별SQL 상세 LIST
-- ======================================================================================================================================

-- --------------------------------------------------------------------------------------------------
-- 기존 실행정보 확인하여 분석 대상 RUN_NAME 선택 
-- --------------------------------------------------------------------------------------------------

SELECT RUN_NAME,RUN_SOURCE,DECODE(LOAD_TEST_YN,'Y','Load Tester','SPT') "Run Type", DESCRIPTION "Description",
       DECODE(RUN_END_DATE,NULL,DECODE(PROC_REST,0,'N/A','Running...'),'Finished') "Run Status",RUN_START_DATE "Job Start Date",RUN_END_DATE "Job End Date",
       TOT_CNT "Target SQL Cnt",PROC_FINISH "Finished SQL Cnt",PROC_REST "Rest SQL Cnt",PROC_PCT "Progress %",
       PROC_P "Running SQL Cnt",PROC_N "Not Run Yet ",PROC_T "Timeout SQL Cnt",PROC_E "Error SQL Cnt",PROC_S "Skip SQL Cnt",PROC_Y "Run OK Cnt",
       PROC_FINISH "Total Runned SQL Cnt", ROUND(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))) "Load Duration(Sec)",
       ROUND(DECODE(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60)),0,0,NULL,0,PROC_FINISH/((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))),2) TPS, 
       -- Configuration Information
       RUN_PROCESS,RUN_SQL_TIMEOUT,RUN_REMAP_STRING,
       RUN_REPLACE_SYSDATE,RUN_NLS_DATE_FORMAT,RUN_PRE_SQL,RUN_POST_SQL,PLAN_COMPARE_YN,PLAN_COMPARE_CHK_RUN_YN,
       USE_SQL_REPLACE,USE_BIND_REPLACE,
       LOAD_REG_DATE,LOAD_TEST_YN,LOAD_PROC_STATUS,LOAD_PROC_THINKTIME,LOAD_PROC_STARTTIME,LOAD_PROC_ENDTIME ,LOAD_PROC_COMMIT_YN,  LOAD_PROC_TYPE,
       USE_QUERY_RESULT_CHK , USE_QUERY_RESULT_LOGGING, USE_QUERY_RESULT_ROWLIMIT, USE_SQL_COMMENT, PREFETCH_COUNT     
FROM ILM_IRPMSPT_RUNINFO
WHERE 1=1
-- AND RUN_NAME like 'ORDERS%'
-- ORDER BY COALESCE(RUN_START_DATE,LOAD_REG_DATE) DESC;
ORDER BY SUBSTR(RUN_NAME,-14) DESC;



-- --------------------------------------------------------------------------------------------------
-- SQL1 : 통계분석
-- --------------------------------------------------------------------------------------------------

SELECT B_RUN_NAME || '.vs.' || A_RUN_NAME RUN_NAME,                                                                                                
       -- -------------------------------------------------------------                                                                            
       -- SQL실행대상, Error발생수, Error 율                                                                                                          
       -- -------------------------------------------------------------                                                                            
       COUNT(SQL_ID)                                                                                         "Total SQL Cnt",                    
       COUNT(DISTINCT SQL_ID)                                                                                "Unique SQL Cnt",                   
       SUM(DECODE(A_EXEC_ERROR,NULL,1,0))                                                                    "Run OK Cnt",                       
       SUM(DECODE(A_EXEC_ERROR,NULL,0,1))                                                                    "Run Error Cnt",                    
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(A_EXEC_ERROR,NULL,0,1))/COUNT(SQL_ID)),3)                   "Run Error Pct%",                   
       COUNT(DISTINCT PARSING_SCHEMA_NAME)                                                                   "Parsing Schema Cnt",               
       -- -------------------------------------------------------------                                                                            
       -- Plan 변경 통계 (주의. Table/Index구조가 바뀌는 경우는 Plan변경에 대한 Summary는 무의미 함)                                                       
       -- -------------------------------------------------------------                                                                            
       SUM(DECODE(PLAN_CHANGED,'N',1,0))                                                                     "Plan Unchange Cnt",                
       SUM(DECODE(PLAN_CHANGED,'Y',1,0))                                                                     "Plan Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'N',1,0))/COUNT(SQL_ID)),3)                    "Plan Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(PLAN_CHANGED,'Y',1,0))/COUNT(SQL_ID)),3)                    "Plan Change Pct%",   
       -- PLAN String
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))                          "Plan Str Unchange Cnt",                
       SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))                          "Plan Str Change Cnt",                  
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'N',1,0))/COUNT(SQL_ID)),3)        "Plan Str Unchange Pct%",               
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(DECODE(CASE WHEN B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  
                       WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END,'Y',1,0))/COUNT(SQL_ID)),3)        "Plan Str Change Pct%",    
       
       -- -------------------------------------------------------------                                                                            
       -- Buffer I/O기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                           
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)                                                   "Buff Improved SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)                                                   "Buff Unchange SQL Cnt",            
       SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)                                                   "Buff Regression SQL Cnt",          
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Improved SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Unchange SQL Pct%",           
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN BUFFER_IO_GAPS < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3)  "Buff Regression SQL Pct%",         
       ROUND(AVG(BUFFER_IO_GAPS),2)                                                                          "Buff Avg Gaps(Blocks)",            
       ROUND(AVG(BUFFER_IO_GAPS*ASIS_EXECUTIONS),2)                                                          "Buff Avg Gaps(Blocks)*Exec",       
       ROUND(MIN(BUFFER_IO_GAPS),2)                                                                          "Buff Min Gaps(Blocks)",            
       ROUND(MAX(BUFFER_IO_GAPS),2)                                                                          "Buff Max Gaps(Blocks)",            
       ROUND(AVG(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Improve Ratio",            
       ROUND(MIN(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Min Improve Ratio",        
       ROUND(MAX(IO_IMPROVE_RATIO)/100,2)                                                                    "Buff IO Max Improve Ratio",        
       -- -------------------------------------------------------------                                                                            
       -- Elapsed Time기준 성능 비교 (Pct%는 Ration이나 EXCEL에서 %처리하면 됨)                                                                         
       -- -------------------------------------------------------------                                                                            
       SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)                                                  "Elapsed Improved SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)                                                  "Elapsed Unchange SQL Cnt",         
       SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)                                                  "Elapsed Regression SQL Cnt",       
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP > 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Improved SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP = 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Unchange SQL Pct%",        
       ROUND(DECODE(COUNT(SQL_ID),0,0,SUM(CASE WHEN ELAPSE_TIME_GAP < 0 THEN 1 ELSE 0 END)/COUNT(SQL_ID)),3) "Elapsed Regression SQL Pct%",      
       ROUND(AVG(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Avg Gaps(Blocks)",         
       ROUND(AVG(ELAPSE_TIME_GAP*ASIS_EXECUTIONS),2)                                                         "Elapsed Avg Gaps(Blocks)*Exec",    
       ROUND(MIN(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Min Gaps(Blocks)",         
       ROUND(MAX(ELAPSE_TIME_GAP),2)                                                                         "Elapsed Max Gaps(Blocks)"          
FROM

-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_HASH(AA BB CC) AWR_EXEC_VS_EXEC */
       TRUNC(SYSDATE)                      RUN_DATE,
       'AWR_SPT[INST,AWR Snap]: [' || TO_CHAR(AA.INSTANCE_NUMBER) ||','|| AA.MIN_SNAP_ID || ' ~ ' || AA.MAX_SNAP_ID || ']'      RUN_INFO,
       BB.RUN_NAME                         B_RUN_NAME,
       AA.RUN_NAME                         A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       (select sql_text from dba_hist_sqltext where rowid = AA.AWR_ROWID)  SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0),5)                                    CPU_USAGE_RATIO,
       B_PLAN,
       A_PLAN,
       B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',B_PLAN_HASH,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE  CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE  B_BUFFER_GETS - A_BUFFER_GETS END BUFFER_IO_GAPS,
       B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0)                ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P') OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE B_ELAPSED_TIME - A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)      ASIS_ELAPSED_TIME,
       B_CPU_TIME,
       A_CPU_TIME,
       B_EXECUTIONS,
       A_EXECUTIONS,
       B_DISK_READS,
       A_DISK_READS,
       B_USER_IO_TIME,
       A_USER_IO_TIME,
       B_ROWS_PROCESSED,
       A_ROWS_PROCESSED,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0)             ASIS_ROWS_PROCESSED,
       B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       B_BUFFER_GETS_2 ,
       A_BUFFER_GETS_2 ,
       B_ELAPSED_TIME_2 ,
       A_ELAPSED_TIME_2 ,
       B_DISK_READS_2 ,
       A_DISK_READS_2 ,
       B_ROWS_PROCESSED_2 ,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       AA.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME,
       BB.SPT_SQL_ID           B_SPT_SQL_ID,
       BB.SPT_PLAN_HASH_VALUE  B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID           A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE  A_SPT_PLAN_HASH_VALUE,

       CASE WHEN BB.QUERY_RESULT_SHA1 IS NULL AND AA.QUERY_RESULT_SHA1 IS NULL THEN NULL
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Same'
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Not Same'
            ELSE NULL
       END QUERY_RESULT_COMP,
       UTL_RAW.CAST_TO_VARCHAR2(BB.QUERY_RESULT_SHA1) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1) A_QUERY_RESULT_SHA1,
       BB.SQL_PROFILE B_SQL_PROFILE,
       AA.SQL_PROFILE A_SQL_PROFILE,
       BB.SQL_PATCH   B_SQL_PATCH,
       AA.SQL_PATCH   A_SQL_PATCH,
       BB.SQL_PLAN_BASELINE B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE A_SQL_PLAN_BASELINE,
       B_EXEC_ERROR,
       A_EXEC_ERROR,
       B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH,
       NULL CHILD_NUMBER
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,MIN_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 Start Snap ID (윰_hist_snapshot)
           ,MAX_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 End Snap ID (dba_hist_snapshot)
           ,DBID                                 -- AWR Only : AWR Repository의 수집대상의 DBID (dba_hist_snapshot)
           ,INSTANCE_NUMBER                      -- AWR Only : AWR Repository의 수집대상의 INSTANCE_NUMBER (dba_hist_snapshot)
           ,AWR_PLAN_HASH_VALUE                  -- AWR Only : AWR Repository의 수집대상SQL의 PLAN_HASH_VALUE (dba_hist_sql_plan)
           ,AWR_ROWID                            -- AWR Only : AWR Repository의 수집대상SQL의 SQL TEXT의 ROWID (dba_hist_sqltext)
           ,PLAN_RUNTIME       B_PLAN
           ,PLAN_RUNTIME_COMP  B_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  B_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                B_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      B_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              B_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     B_USER_IO_TIME
           ,EXECUTIONS                                                                                B_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 B_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                B_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    B_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          B_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     B_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 B_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        B_PREFETCH_CNT
           ,EXEC_ERROR                                                                                B_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH B_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME = '@@RUNNAME_BEFORE@@'
      AND RUN_SOURCE like 'AWR%'
    ) BB,
    (select
            y.RUN_NAME
           ,y.sql_id
           ,MIN_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 Start Snap ID (dba_hist_snapshot)
           ,MAX_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 End Snap ID (dba_hist_snapshot)
           ,DBID                                 -- AWR Only : AWR Repository의 수집대상의 DBID (dba_hist_snapshot)
           ,INSTANCE_NUMBER                      -- AWR Only : AWR Repository의 수집대상의 INSTANCE_NUMBER (dba_hist_snapshot)
           ,AWR_PLAN_HASH_VALUE                  -- AWR Only : AWR Repository의 수집대상SQL의 PLAN_HASH_VALUE (dba_hist_sql_plan)
           ,AWR_ROWID                            -- AWR Only : AWR Repository의 수집대상SQL의 SQL TEXT의 ROWID (dba_hist_sqltext)
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           --V$SQL (여기서 가져오는 컬럼은 _2로 했음)
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR                                                                                A_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE
           ,COMMAND_TYPE  , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
     AND RUN_NAME = '@@RUNNAME_AFTER@@'
     AND RUN_SOURCE like 'AWR%'
    ) AA ,
    (select  /*+ LEADING(SN SY) NO_MERGE(SN) USE_HASH(SN SY) FULL(sy) */
              sy.dbid, sy.sql_id,sy.plan_hash_value
            , NVL(sum(ELAPSED_TIME_DELTA)           ,0) ELAPSED_TIME
            , NVL(sum(CPU_TIME_DELTA)               ,0) CPU_TIME
            , NVL(sum(EXECUTIONS_DELTA)             ,0) EXECUTIONS
            , NVL(sum(FETCHES_DELTA)                ,0) FETCHES
            , NVL(sum(END_OF_FETCH_COUNT_DELTA)     ,0) END_OF_FETCH_COUNT
            , NVL(sum(SORTS_DELTA)                  ,0) SORTS
            , NVL(sum(PX_SERVERS_EXECS_DELTA)       ,0) PX_SERVERS_EXECS
            , NVL(sum(LOADS_DELTA)                  ,0) LOADS
            , NVL(sum(INVALIDATIONS_DELTA)          ,0) INVALIDATIONS
            , NVL(sum(PARSE_CALLS_DELTA)            ,0) PARSE_CALLS
            , NVL(sum(DISK_READS_DELTA)             ,0) DISK_READS
            , NVL(sum(BUFFER_GETS_DELTA)            ,0) BUFFER_GETS
            , NVL(sum(ROWS_PROCESSED_DELTA)         ,0) ROWS_PROCESSED
            , NVL(sum(IOWAIT_DELTA)                 ,0) IOWAIT
            , NVL(sum(CLWAIT_DELTA)                 ,0) CLWAIT
            , NVL(sum(APWAIT_DELTA)                 ,0) APWAIT
            , NVL(sum(CCWAIT_DELTA)                 ,0) CCWAIT
            , NVL(sum(DIRECT_WRITES_DELTA)          ,0) DIRECT_WRITES
            , NVL(sum(PLSEXEC_TIME_DELTA)           ,0) PLSEXEC_TIME
            , NVL(sum(JAVEXEC_TIME_DELTA)           ,0) JAVEXEC_TIME
            , MAX(FORCE_MATCHING_SIGNATURE)             FORCE_MATCHING_SIGNATURE
            , MAX(MODULE)                               MODULE
            , MAX(PARSING_SCHEMA_NAME)                  PARSING_SCHEMA_NAME
            , MAX(BIND_DATA)                            BIND_DATA
            , MIN('SNAP_ID:' || SNAP_ID)                FIRST_LOAD_TIME
      from  (SELECT DBID,INSTANCE_NUMBER,SQL_ID ,MIN_SNAP_ID ,MAX_SNAP_ID
            from   ILM_IRPMSPT_RUN y
            WHERE  RUN_NAME = '@@RUNNAME_BEFORE@@'
              AND  RUN_SOURCE like 'AWR%'
            ) V1,
            dba_hist_sqlstat  sy
     WHERE  1=1
       and sy.snap_id         BETWEEN V1.MIN_SNAP_ID AND V1.MAX_SNAP_ID
       and sy.dbid            = V1.dbid
       and sy.instance_number = V1.instance_number
       and sy.sql_id          = V1.sql_id
     group by sy.dbid,sy.sql_id,sy.plan_hash_value) CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE 1=1
  AND AA.MIN_SNAP_ID           = BB.MIN_SNAP_ID
  AND AA.MAX_SNAP_ID           = BB.MAX_SNAP_ID
  AND AA.DBID                  = BB.DBID
  AND AA.INSTANCE_NUMBER       = BB.INSTANCE_NUMBER
  AND AA.AWR_PLAN_HASH_VALUE   = BB.AWR_PLAN_HASH_VALUE
  AND AA.SQL_ID                = BB.SQL_ID
  AND AA.DBID                  = CC.DBID
  AND AA.SQL_ID                = CC.SQL_ID
  AND AA.AWR_PLAN_HASH_VALUE   = CC.PLAN_HASH_VALUE
  AND AA.SQL_ID                = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID                = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
GROUP BY B_RUN_NAME || '.vs.' || A_RUN_NAME; 




-- --------------------------------------------------------------------------------------------------
-- SQL2 : 개별SQL 상세 LIST
-- --------------------------------------------------------------------------------------------------

SELECT QQ.*
FROM (SELECT ROW_NUMBER() OVER(ORDER BY ASIS_EXECUTIONS DESC) SEQ, RUN_DATE, RUN_INFO, B_RUN_NAME, A_RUN_NAME, SQL_ID, ASIS_EXECUTIONS, IO_IMPROVE_RATIO, IO_IMPACT_ESTIMATE, BUFFER_IO_GAPS,
       B_BUFFER_GETS, A_BUFFER_GETS, ASIS_BUFFER_GETS, PARSING_SCHEMA_NAME, MODULE, SQL_TEXT, CPU_USAGE_RANK, CPU_USAGE_RATIO, B_PLAN, A_PLAN,
       B_PLAN_COMPARE,A_PLAN_COMPARE, B_PLAN_RUNTIME_COMP_HASH B_PLAN_STRING_HASH, A_PLAN_RUNTIME_COMP_HASH A_PLAN_STRING_HASH, 
       CASE WHEN  B_PLAN_RUNTIME_COMP_HASH IS NULL OR A_PLAN_RUNTIME_COMP_HASH IS NULL THEN 'X'  WHEN B_PLAN_RUNTIME_COMP_HASH = A_PLAN_RUNTIME_COMP_HASH THEN 'N' ELSE 'Y' END   PLAN_STRING_CHANGED, 
       B_PLAN_HASH, A_PLAN_HASH, PLAN_CHANGED, ELAPSE_TIME_GAP, B_ELAPSED_TIME, A_ELAPSED_TIME,ASIS_ELAPSED_TIME,B_CPU_TIME, A_CPU_TIME,
       B_EXECUTIONS, A_EXECUTIONS, B_DISK_READS, A_DISK_READS, B_USER_IO_TIME, A_USER_IO_TIME, B_ROWS_PROCESSED, A_ROWS_PROCESSED  , ASIS_ROWS_PROCESSED, B_PREFETCH_CNT,
       A_PREFETCH_CNT,  B_BUFFER_GETS_2 ,A_BUFFER_GETS_2 ,B_ELAPSED_TIME_2,A_ELAPSED_TIME_2 , B_DISK_READS_2, A_DISK_READS_2 , B_ROWS_PROCESSED_2, A_ROWS_PROCESSED_2 , BIND_VALUE,ELAPSED_TIME,
       CPU_TIME, BUFFER_GETS, DIRECT_WRITES, FETCHES, COMMAND_TYPE, FORCE_MATCHING_SIGNATURE, FIRST_LOAD_TIME ,CHILD_NUMBER, B_SPT_SQL_ID, B_SPT_PLAN_HASH_VALUE,
       A_SPT_SQL_ID, A_SPT_PLAN_HASH_VALUE, QUERY_RESULT_COMP, B_QUERY_RESULT_SHA1, A_QUERY_RESULT_SHA1, B_SQL_PROFILE, A_SQL_PROFILE, B_SQL_PATCH,
       A_SQL_PATCH, B_SQL_PLAN_BASELINE, A_SQL_PLAN_BASELINE, SQL_PLAN_BASELINE_YN, SQL_PROFILS_YN, COUNT(*) OVER() TOT_COUNT , B_EXEC_ERROR, A_EXEC_ERROR
FROM
-- ############################################################################################## START
(SELECT /*+ LEADING(AA BB) USE_HASH(AA BB CC) AWR_EXEC_VS_EXEC */
       TRUNC(SYSDATE)                      RUN_DATE,
       'AWR_SPT[INST,AWR Snap]: [' || TO_CHAR(AA.INSTANCE_NUMBER) ||','|| AA.MIN_SNAP_ID || ' ~ ' || AA.MAX_SNAP_ID || ']'      RUN_INFO,
       BB.RUN_NAME                         B_RUN_NAME,
       AA.RUN_NAME                         A_RUN_NAME,
       CC.SQL_ID,
       DECODE(DD.BASELINE_SQL_ID,NULL,'N','Y')        SQL_PLAN_BASELINE_YN,
       DECODE(EE.SQLPROFILE_SQL_ID,NULL,'N','Y')      SQL_PROFILS_YN,
       CC.PARSING_SCHEMA_NAME,
       CC.MODULE,
       (select sql_text from dba_hist_sqltext where rowid = AA.AWR_ROWID)  SQL_TEXT,
       RANK() OVER (ORDER BY CC.CPU_TIME DESC)                                                 CPU_USAGE_RANK,
       ROUND(nvl(ratio_to_report(CC.CPU_TIME) over (),0),5)                                    CPU_USAGE_RATIO,
       B_PLAN,
       A_PLAN,
       B_PLAN_COMPARE,
       A_PLAN_COMPARE,
       B_PLAN_HASH,
       A_PLAN_HASH,
       DECODE(A_PLAN_HASH,NULL,'',B_PLAN_HASH,'N','Y')   PLAN_CHANGED,
       CC.EXECUTIONS AS ASIS_EXECUTIONS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END END IO_IMPROVE_RATIO,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE  CASE WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) > 0 THEN
               round(decode(B_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/B_BUFFER_GETS)*100,2)),2)
            WHEN  (B_BUFFER_GETS - A_BUFFER_GETS) < 0 THEN
               round(decode(A_BUFFER_GETS,0,0,round(((B_BUFFER_GETS - A_BUFFER_GETS)/A_BUFFER_GETS)*100,2)),2)
            ELSE 0.00
       END * CC.EXECUTIONS END IO_IMPACT_ESTIMATE,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P')  OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE  B_BUFFER_GETS - A_BUFFER_GETS END BUFFER_IO_GAPS,
       B_BUFFER_GETS,
       A_BUFFER_GETS,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.buffer_gets,0)/CC.executions)),0)                ASIS_BUFFER_GETS,
       CASE WHEN AA.RUN_PROC_YN IN ('T','E','S','P') OR BB.RUN_PROC_YN IN ('T','E','S','P')  THEN NULL ELSE B_ELAPSED_TIME - A_ELAPSED_TIME END ELAPSE_TIME_GAP,
       B_ELAPSED_TIME,
       A_ELAPSED_TIME,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ELAPSED_TIME,0)/CC.executions)/ 1000000),5)      ASIS_ELAPSED_TIME,
       B_CPU_TIME,
       A_CPU_TIME,
       B_EXECUTIONS,
       A_EXECUTIONS,
       B_DISK_READS,
       A_DISK_READS,
       B_USER_IO_TIME,
       A_USER_IO_TIME,
       B_ROWS_PROCESSED,
       A_ROWS_PROCESSED,
       round(decode(CC.executions,null,0,0,0,(nvl(CC.ROWS_PROCESSED,0)/CC.executions)),0)             ASIS_ROWS_PROCESSED,
       B_PREFETCH_CNT,
       A_PREFETCH_CNT,
       B_BUFFER_GETS_2 ,
       A_BUFFER_GETS_2 ,
       B_ELAPSED_TIME_2 ,
       A_ELAPSED_TIME_2 ,
       B_DISK_READS_2 ,
       A_DISK_READS_2 ,
       B_ROWS_PROCESSED_2 ,
       A_ROWS_PROCESSED_2 ,
       iRPM_SPT.GET_SQLBIND_STS(CC.BIND_DATA) AS BIND_VALUE,
       CC.ELAPSED_TIME,
       CC.CPU_TIME,
       CC.BUFFER_GETS,
       CC.DIRECT_WRITES,
       CC.FETCHES,
       AA.COMMAND_TYPE,
       CC.FORCE_MATCHING_SIGNATURE,
       CC.FIRST_LOAD_TIME,
       BB.SPT_SQL_ID           B_SPT_SQL_ID,
       BB.SPT_PLAN_HASH_VALUE  B_SPT_PLAN_HASH_VALUE,
       AA.SPT_SQL_ID           A_SPT_SQL_ID,
       AA.SPT_PLAN_HASH_VALUE  A_SPT_PLAN_HASH_VALUE,

       CASE WHEN BB.QUERY_RESULT_SHA1 IS NULL AND AA.QUERY_RESULT_SHA1 IS NULL THEN NULL
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Same'
            WHEN BB.QUERY_RESULT_SHA1 = AA.QUERY_RESULT_SHA1 THEN 'Query Result Not Same'
            ELSE NULL
       END QUERY_RESULT_COMP,
       UTL_RAW.CAST_TO_VARCHAR2(BB.QUERY_RESULT_SHA1) B_QUERY_RESULT_SHA1,
       UTL_RAW.CAST_TO_VARCHAR2(AA.QUERY_RESULT_SHA1) A_QUERY_RESULT_SHA1,
       BB.SQL_PROFILE B_SQL_PROFILE,
       AA.SQL_PROFILE A_SQL_PROFILE,
       BB.SQL_PATCH   B_SQL_PATCH,
       AA.SQL_PATCH   A_SQL_PATCH,
       BB.SQL_PLAN_BASELINE B_SQL_PLAN_BASELINE,
       AA.SQL_PLAN_BASELINE A_SQL_PLAN_BASELINE,
       B_EXEC_ERROR,
       A_EXEC_ERROR,
       B_PLAN_RUNTIME_COMP_HASH,
       A_PLAN_RUNTIME_COMP_HASH,
       NULL CHILD_NUMBER
FROM
    (select
            y.RUN_NAME
           ,y.sql_id
           ,MIN_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 Start Snap ID (윰_hist_snapshot)
           ,MAX_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 End Snap ID (dba_hist_snapshot)
           ,DBID                                 -- AWR Only : AWR Repository의 수집대상의 DBID (dba_hist_snapshot)
           ,INSTANCE_NUMBER                      -- AWR Only : AWR Repository의 수집대상의 INSTANCE_NUMBER (dba_hist_snapshot)
           ,AWR_PLAN_HASH_VALUE                  -- AWR Only : AWR Repository의 수집대상SQL의 PLAN_HASH_VALUE (dba_hist_sql_plan)
           ,AWR_ROWID                            -- AWR Only : AWR Repository의 수집대상SQL의 SQL TEXT의 ROWID (dba_hist_sqltext)
           ,PLAN_RUNTIME       B_PLAN
           ,PLAN_RUNTIME_COMP  B_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  B_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                B_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      B_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              B_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     B_USER_IO_TIME
           ,EXECUTIONS                                                                                B_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 B_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                B_ROWS_PROCESSED
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    B_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          B_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     B_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 B_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        B_PREFETCH_CNT
           ,EXEC_ERROR                                                                                B_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH B_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
      AND RUN_NAME = '@@RUNNAME_BEFORE@@'
      AND RUN_SOURCE like 'AWR%'
    ) BB,
    (select
            y.RUN_NAME
           ,y.sql_id
           ,MIN_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 Start Snap ID (dba_hist_snapshot)
           ,MAX_SNAP_ID                          -- AWR Only : AWR Repository의 수집대상의 End Snap ID (dba_hist_snapshot)
           ,DBID                                 -- AWR Only : AWR Repository의 수집대상의 DBID (dba_hist_snapshot)
           ,INSTANCE_NUMBER                      -- AWR Only : AWR Repository의 수집대상의 INSTANCE_NUMBER (dba_hist_snapshot)
           ,AWR_PLAN_HASH_VALUE                  -- AWR Only : AWR Repository의 수집대상SQL의 PLAN_HASH_VALUE (dba_hist_sql_plan)
           ,AWR_ROWID                            -- AWR Only : AWR Repository의 수집대상SQL의 SQL TEXT의 ROWID (dba_hist_sqltext)
           ,PLAN_RUNTIME       A_PLAN
           ,PLAN_RUNTIME_COMP  A_PLAN_COMPARE
           ,y.PLAN_HASH_VALUE  A_PLAN_HASH
           ,round(decode(executions,null,0,0,0,(nvl(SQL_BUFFER_GETS,0)/executions)),0)                A_BUFFER_GETS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_ELAPSED_TIME,0)/executions)/ 1000000),5)      A_ELAPSED_TIME
           ,round(decode(executions,null,0,0,0,(nvl(CPU_TIME,0)/executions)/ 1000000),5)              A_CPU_TIME
           ,round(decode(executions,null,0,0,0,(nvl(USER_IO_WAIT_TIME,0)/executions)/ 1000000),5)     A_USER_IO_TIME
           ,EXECUTIONS                                                                                A_EXECUTIONS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_DISK_READS,0)/executions)),0)                 A_DISK_READS
           ,round(decode(executions,null,0,0,0,(nvl(SQL_OUTPUT_ROWS,0)/executions)),0)                A_ROWS_PROCESSED
           --V$SQL (여기서 가져오는 컬럼은 _2로 했음)
           ,round(decode(executions,null,0,0,0,(nvl(buffer_gets,0)/executions)),0)                    A_BUFFER_GETS_2
           ,round(decode(executions,null,0,0,0,(nvl(ELAPSED_TIME,0)/executions)/ 1000000),5)          A_ELAPSED_TIME_2
           ,round(decode(executions,null,0,0,0,(nvl(DISK_READS,0)/executions)),0)                     A_DISK_READS_2
           ,round(decode(executions,null,0,0,0,(nvl(ROWS_PROCESSED,0)/executions)),0)                 A_ROWS_PROCESSED_2
           ,DECODE(FETCHES,0,1,NULL,1,DECODE(ROWS_PROCESSED,0,1,CEIL(ROWS_PROCESSED/FETCHES)))        A_PREFETCH_CNT
           ,EXEC_ERROR                                                                                A_EXEC_ERROR
           ,STS_ROWID
           ,SPT_SQL_ID
           ,SPT_PLAN_HASH_VALUE
           ,QUERY_RESULT_SHA1
           ,SQL_PROFILE
           ,SQL_PATCH
           ,SQL_PLAN_BASELINE
           ,COMMAND_TYPE  , RUN_PROC_YN
           ,PLAN_RUNTIME_COMP_HASH A_PLAN_RUNTIME_COMP_HASH
    from   ILM_IRPMSPT_RUN y
    WHERE 1 = 1
     AND RUN_NAME = '@@RUNNAME_AFTER@@'
     AND RUN_SOURCE like 'AWR%'
    ) AA ,
    (select  /*+ LEADING(SN SY) NO_MERGE(SN) USE_HASH(SN SY) FULL(sy) */
              sy.dbid, sy.sql_id,sy.plan_hash_value
            , NVL(sum(ELAPSED_TIME_DELTA)           ,0) ELAPSED_TIME
            , NVL(sum(CPU_TIME_DELTA)               ,0) CPU_TIME
            , NVL(sum(EXECUTIONS_DELTA)             ,0) EXECUTIONS
            , NVL(sum(FETCHES_DELTA)                ,0) FETCHES
            , NVL(sum(END_OF_FETCH_COUNT_DELTA)     ,0) END_OF_FETCH_COUNT
            , NVL(sum(SORTS_DELTA)                  ,0) SORTS
            , NVL(sum(PX_SERVERS_EXECS_DELTA)       ,0) PX_SERVERS_EXECS
            , NVL(sum(LOADS_DELTA)                  ,0) LOADS
            , NVL(sum(INVALIDATIONS_DELTA)          ,0) INVALIDATIONS
            , NVL(sum(PARSE_CALLS_DELTA)            ,0) PARSE_CALLS
            , NVL(sum(DISK_READS_DELTA)             ,0) DISK_READS
            , NVL(sum(BUFFER_GETS_DELTA)            ,0) BUFFER_GETS
            , NVL(sum(ROWS_PROCESSED_DELTA)         ,0) ROWS_PROCESSED
            , NVL(sum(IOWAIT_DELTA)                 ,0) IOWAIT
            , NVL(sum(CLWAIT_DELTA)                 ,0) CLWAIT
            , NVL(sum(APWAIT_DELTA)                 ,0) APWAIT
            , NVL(sum(CCWAIT_DELTA)                 ,0) CCWAIT
            , NVL(sum(DIRECT_WRITES_DELTA)          ,0) DIRECT_WRITES
            , NVL(sum(PLSEXEC_TIME_DELTA)           ,0) PLSEXEC_TIME
            , NVL(sum(JAVEXEC_TIME_DELTA)           ,0) JAVEXEC_TIME
            , MAX(FORCE_MATCHING_SIGNATURE)             FORCE_MATCHING_SIGNATURE
            , MAX(MODULE)                               MODULE
            , MAX(PARSING_SCHEMA_NAME)                  PARSING_SCHEMA_NAME
            , MAX(BIND_DATA)                            BIND_DATA
            , MIN('SNAP_ID:' || SNAP_ID)                FIRST_LOAD_TIME
      from  (SELECT DBID,INSTANCE_NUMBER,SQL_ID ,MIN_SNAP_ID ,MAX_SNAP_ID
            from   ILM_IRPMSPT_RUN y
            WHERE  RUN_NAME = '@@RUNNAME_BEFORE@@'
              AND  RUN_SOURCE like 'AWR%'
            ) V1,
            dba_hist_sqlstat  sy
     WHERE  1=1
       and sy.snap_id         BETWEEN V1.MIN_SNAP_ID AND V1.MAX_SNAP_ID
       and sy.dbid            = V1.dbid
       and sy.instance_number = V1.instance_number
       and sy.sql_id          = V1.sql_id
     group by sy.dbid,sy.sql_id,sy.plan_hash_value) CC,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) BASELINE_SQL_ID FROM DBA_SQL_PLAN_BASELINES) DD,
    (SELECT DISTINCT IRPM_SPT.SQLTEXT_TO_SQLID(SQL_TEXT) SQLPROFILE_SQL_ID FROM DBA_SQL_PROFILES) EE
WHERE 1=1
  AND AA.MIN_SNAP_ID           = BB.MIN_SNAP_ID
  AND AA.MAX_SNAP_ID           = BB.MAX_SNAP_ID
  AND AA.DBID                  = BB.DBID
  AND AA.INSTANCE_NUMBER       = BB.INSTANCE_NUMBER
  AND AA.AWR_PLAN_HASH_VALUE   = BB.AWR_PLAN_HASH_VALUE
  AND AA.SQL_ID                = BB.SQL_ID
  AND AA.DBID                  = CC.DBID
  AND AA.SQL_ID                = CC.SQL_ID
  AND AA.AWR_PLAN_HASH_VALUE   = CC.PLAN_HASH_VALUE
  AND AA.SQL_ID                = DD.BASELINE_SQL_ID(+)
  AND AA.SQL_ID                = EE.SQLPROFILE_SQL_ID(+)
  --WHERE_PREDICATE
 ) MAIN
-- ############################################################################################## END
 
) QQ
ORDER BY ASIS_EXECUTIONS DESC;
VAR=2
:FINDREMAPSTR=0,
:REPLACEREMAPSTR=0,
NAME=0101.LOAD_TEST_Sample.sql
STMT=493
-- ======================================================================================================================================
-- 0101.LOAD_TEST.sql 
-- [SCRIPT 0101 : iRPM SPT의 수집된 SQL들의 LOAD TEST Sample ]
-- 
-- UGENS SPT 부하발생기 
--    in_RUN_SOURCE==> 'STS' : from iRPM SQL수집 대상 또는 STS(SQL Tuning Set) Source사용. ILM_IRPMSPT_SQLSET_STAGE에 수집된 대상을 이용하여 SPT실행시 사용
--    in_RUN_SOURCE==> 'AWR' : from AWR Source사용 (AWR에서 분석대상 직접 취합하여 실행)
--
--    아래의 입력변수 및 in_PREDICATE 조건을 지정하여 실행
-- 
--    > job_queue_processess는 기존 Job(Scheduler, dbms_job)과 실행 Process수를 고려하여 충분히 설정
--      alter system set job_queue_processes=1000;
--    
--    > 예) 아래의 예는 SOE.ORDERS에 속한 SQL문장들을  LOAD TEST (Stop할 떄까지 Random하게 계속 실행)
--          -->  in_USE_SQL_REPLACE_YN    := 'Y';     SQL_ID가 ILM_IRPMSPT_SQL_REPLACE Table에 변경(튜닝 및 조정)될 대상이 있을 경우 Replace해서 실행
--          -->  in_USE_BIND_REPLACE_YN   := 'N';     BIND Value Replace 기능은 사용하지 않음 (ILM_IRPMSPT_BIND_INFO에 Replace대상 Bind변수가 등록이 되어 있어도 사용하지 않고 Original 수집된 Bind값 사용)
--          -->  in_LOAD_TEST_YN          := 'Y';     부하 발생기로 Start/Stop할 떄까지 계속 실행
--          -->  in_LOAD_PROC_TYPE        := 'C';     부하발생기는 SQL_ID를 동시(Concurrently)에 여러 Process에서 동시 실행하도록 설덩 ('O'일 경우는 Only One - 한 시점에 1개의 Process만 특정 SQL_ID를 실행
--          -->  참고) ILM_IRPMSPT_BIND_LIST에 Bind변수 List들이 등록이 돠어 있고 ILM_IRPMSPT_BIND_INFO.LOAD_PROC_TYPE 에 따라 (S,R,N) S:SEQUENCE 1~MAX~1~, R:RANDOM SEQ (MIN ~ MAX), N:Not Used 
--                    Bind변수가 바뀌면서 실행될 수 있음. 즉 ILM_IRPMSPT_BIND_LIST Table은 부하발생기의 총알 Table임                        
-- ======================================================================================================================================

DECLARE
    out_RUN_NAME            VARCHAR2(200);
    v_NodeCount             NUMBER;
                            
    in_STS_OWNER            VARCHAR2(256);  
    in_STS_TABLE_NAME       VARCHAR2(256);
    in_SPT_WORKTBL_OWNER    VARCHAR2(256);  
    in_SPT_WORKTBL_NAME     VARCHAR2(256);
    in_SPT_LOGTBL_OWNER     VARCHAR2(256);  
    in_SPT_LOGTBL_NAME      VARCHAR2(256);
    in_RUN_SOURCE           VARCHAR2(20);
    in_PARALLEL_PROC        NUMBER;    
    in_AWR_SQLTARGET_DAYS   NUMBER;  
    in_AWR_STARTDT          VARCHAR2(100);
    in_AWR_ENDDT            VARCHAR2(100);    
    in_DESCRIPTION          VARCHAR2(2000);
    in_PREDICATE            VARCHAR2(4000);
    in_JOB_CODE             VARCHAR2(15);
                            
    in_TABLE_OWNER          VARCHAR2(256);  
    in_TABLE_NAME           VARCHAR2(256);
    in_RUN_NODE_LIST        VARCHAR2(1000);
                            
    in_RUN_SQL_TIMEOUT      NUMBER;
    in_RUN_REMAP_STRING     CLOB;
    in_RUN_REPLACE_SYSDATE  VARCHAR2(14);
    in_RUN_NLS_DATE_FORMAT  VARCHAR2(100); 
    in_RUN_PRE_SQL          CLOB;
    in_RUN_POST_SQL         CLOB;   
    in_PRE_PLAN_COMPARE_YN  CHAR(1); 
    in_PLAN_COMP_CHK_RUN_YN CHAR(1);
    in_USE_SQL_REPLACE_YN   CHAR(1);                              
    in_USE_BIND_REPLACE_YN  CHAR(1);
    in_LOAD_TEST_YN         CHAR(1);
    in_LOAD_PROC_TYPE       CHAR(1);  
    in_USE_QUERY_RESULT_CHK CHAR(1);
    in_USE_QUERY_RESULT_LOG CHAR(1);    
    in_USE_QUERY_RESULT_ROWLIMIT NUMBER;
    in_LOAD_PROC_THINKTIME  NUMBER;
    in_PREFETCH_COUNT       NUMBER;
    in_USE_SQL_COMMENT      CHAR(1); 
    
    v_code                  NUMBER          := NULL;
    v_errm                  VARCHAR2(2048)  := ''; 
    v_II                    NUMBER; 
    in_LICENSE_KEY          VARCHAR2(128);   
BEGIN

    -- #####################################################################################################################################################
    -- 아래 변수를 수정하여 실행
    --
    --   in_SPT_LOGTBL_OWNER , in_SPT_LOGTBL_NAME  : SPT실행을 위한 LOG Table의 OWNER, TABLE_NAME (FIXED Name : ILM_IRPMSPT_LOG_WORK)
    --   in_SPT_WORKTBL_OWNER, in_SPT_WORKTBL_NAME : SPT실행을 위한 성능정보 수집 Table의 OWNER, TABLE_NAME, 성능정보 수집 대상 TABLE
    --   in_STS_OWNER,in_SYSTEM_NAME               : iRPM Staging Table의 OWNER, TABLE_NAME
    --   in_RUN_SOURCE                             : IRPMSPT의 수집 Source ('STS','AWR') 2개의 RESERVERD CODE
    --   in_PARALLEL_PROC                          : IRPM SPT의 실행 병렬도
    --   in_AWR_SQLTARGET_DAYS                     : 현재로 부터 AWR Repository의 몇일전 Data에 대해 분석할 것인지를 지정 in_RUN_SOURCE가 AWR일경우만 지정
    --   in_AWR_STARTDT                            : AWR일 경우 AWR START DATE - YYYY-MM-DD Format
    --   in_AWR_ENDDT                              : AWR일 경우 AWR END DATE - YYYY-MM-DD Format         
    --   in_JOB_CODE                               : JOB Unique Name (MAX 15 BYTE), 주로 TABLE_NAME등 구별 문자 
    --                                               JOB_NAME 구성 > IRPMSPT_[in_JOB_CODE]_001 = 30-12 = 18 BYTE 여유
    --                                               RUN_NAME 구성 > [in_JOB_CODE]_YYYYMMDDHH24MISS = 30-15 = 15 여유
    --   in_TABLE_OWNER , in_TABLE_NAME            : STS, AWR 에서 특정 TABLE에 속한 SQL문장만 실행을 위한 in_PREDICATE 조건 구성 Input
    --   in_RUN_NODE_LIST                          : JOB을 특정 Node들에서 실행할 경우 RAC Node번호, 지정하지 않을 경우 실행 Node에서 실행 예) '1,2' '1,3,4'
    --   in_RUN_SQL_TIMEOUT                        : SQL실행 Timeout Sec(0 - UNLIMIT, >0 실행 Timeout
    --   in_RUN_REMAP_STRING                       : TABLE등을 임시 TABLE이름으로 만든 후 SQL을 수정(REMAP)하여 돌릴 경우 REMAP STring
    --                                               EMP:EMP_$T,EMP_PK:EMP_PK_$T,DEPT:DEPT_$T,.... 과 같이 지정   
    --   in_RUN_REPLACE_SYSDATE                    : SYSDATE, SYSTIMESTAMP를 지정한 날짜로 변경하여 실행 (FORMAT : YYYYMMDDHH24MISS)
    --   in_RUN_NLS_DATE_FORMAT                    : SQL들이 날짜 Type에 대해 String으로 지정할 경우 사용될 Date Format, NULL --> 'YYYY-MM-DD HH24:MI:SS' 
    --   in_RUN_PRE_SQL                            : SQL실행전 환경 설정을 위한 Pre SQL, ';'로 구분 (주로 Init.ora Parameter), Public Synonym 설정 등
    --
    --                                               ALTER SYSTEM FIXED_DATE='2019-05-01 00:00:00; '
    --
    --                                               'ALTER SESSION SET optimizer_use_pending_statistics=true; '  ||
    --                                               'ALTER SESSION SET optimizer_use_invisible_indexes =true; '  || 
    --                                               'ALTER SESSION SET optimizer_use_sql_plan_baselines=false; ' ||
    --                                               'ALTER SESSION SET optimizer_dynamic_sampling=0; ' ;         ||
    --                                               'ALTER SESSION SET optimizer_dynamic_sampling=0; ' ;
    --
    --                                               -- 설정 관련 Parameter
    --                                               optimizer_features_enable ,optimizer_mode , optimizer_index_cost_adj, optimizer_index_caching, 
    --                                               optimizer_dynamic_sampling,optimizer_use_pending_statistics,optimizer_use_sql_plan_baselines,
    --                                               optimizer_use_invisible_indexes,optimizer_adaptive_plans,optimizer_adaptive_statistics,_optimizer_use_feedback,
    --                                               _add_col_optim_enabled,_index_join_enabled,_optim_peek_user_binds,_optimizer_adaptive_cursor_sharing,
    --                                               _optimizer_aggr_groupby_elim,_optimizer_band_join_aware,_optimizer_extended_cursor_sharing,
    --                                               _optimizer_extended_cursor_sharing_rel,_optimizer_gather_stats_on_load,db_file_multiblock_read_count,...
    --
    --   in_RUN_POST_SQL                           : 모든 SQL들을 처리 후 종료 전에 실행할 Post SQL , ';'로 구분 
    --   in_PRE_PLAN_COMPARE_YN                    : Repository의 수집 SQL과 PLAN (EXPLAIN PLAN)비교 후 같은 PLAN여부 확인 Y/N, Y일 경우 PLAN비교
    --   in_PLAN_COMP_CHK_RUN_YN                   : Repository의 수집 SQL과 PLAN (EXPLAIN PLAN)비교 후 다를 경우 SPT로 SQL실행 여부 Y/N, N일 경우 PLAN만 비교
    --   in_PREDICATE                              : Repository (STS, AWR)로 부터 실행 대상 SQL 추출을 위한 Predicate조건
    --
    --   in_USE_SQL_REPLACE_YN                     : REPLACE SQL_TEXT to 튜닝 SQL_TEXT on ILM_IRPMSPT_SQL_REPLACE Table        
    --   in_USE_BIND_REPLACE_YN                    : BIND Value Replace Y/N
    --   in_LOAD_TEST_YN                           : SPT Load Test Y or N 
    --   in_LOAD_PROC_TYPE                         : C or O : C(sql_id에 한시점에 여러 Process들이 동시 실행가능, Timeout가능 사용불가),O(sql_id에 한 시점에 한개의 Process만 실행가능, Timeout기능 가능)
    --   in_LOAD_PROC_THINKTIME                    : 부하발생시 Thinktime (Sleeptime between SQLs) 1/100초 단위 (0.01 ~ ) 단위 초    
    --   in_USE_QUERY_RESULT_CHK                   : Query Result 비교목적 DBMS_SQLHASH를 이용한 SQL결과 저장 
    --   in_USE_QUERY_RESULT_LOG                   : Query Result 비교목적 DBMS_SQLHASH를 이용한 RUN SQL Logging in ILM_IRPMSPT_DIGITALSLOG    
    --   in_USE_QUERY_RESULT_ROWLIMIT              : SQL Query Result Return Row Check Limit (0-All Rows, n-First n Rows)
    --   in_PREFETCH_COUNT                         : Select Query Prefetch Count, PREFETCH_COUNT = -1 (1 ROW FETCH) , FETCH_COUNT = 0 (계산된 FETCH) , FETCH_COUNT > 0  : (FIXED FETCH) 
    --   in_USE_SQL_COMMENT                        : SQL COMMENT Usage in SPT SQL, Attach Comment in Oraginal SQL    
    -- =======================================================================================================================================================
    
    in_LICENSE_KEY           := 'cLmVj83ycCv7eCsH3KsgfQ==';              -- iRPM_SPT License Key
    in_SPT_LOGTBL_OWNER      := sys_context('USERENV', 'SESSION_USER');  -- ILM_IRPMSPT_LOG_WORK Table Owner
    in_SPT_LOGTBL_NAME       := 'ILM_IRPMSPT_LOG_WORK';                  -- ILM_IRPMSPT_LOG_WORK 고정, 변경 불가 
    in_SPT_WORKTBL_OWNER     := sys_context('USERENV', 'SESSION_USER');  -- WORK Table의 OWNER
    in_SPT_WORKTBL_NAME      := 'ILM_IRPMSPT_RUN';                       -- WORK Table Name (사용자 지정 Table, 조정 가능)
    in_STS_OWNER             := sys_context('USERENV', 'SESSION_USER');  -- STS일경우 STS Staging Table의 OWNER
    in_STS_TABLE_NAME        := 'ILM_IRPMSPT_SQLSET_STAGE';              -- STS일경우 STS Staging Table (사용자 지정 Table, 조정 가능)  
    in_AWR_SQLTARGET_DAYS    := 14;                                      -- AWR일 경우 현재로 부터 지정된 일자 전까지의 SQL을 대상으로 수집 , STS는 무시
    in_AWR_STARTDT           := TRIM(TO_CHAR(SYSDATE - 14,'YYYY-MM-DD'));-- AWR일 경우 AWR START DATE - YYYY-MM-DD Format
    in_AWR_ENDDT             := TRIM(TO_CHAR(SYSDATE     ,'YYYY-MM-DD'));-- AWR일 경우 AWR END DATE - YYYY-MM-DD Format 
    
    in_JOB_CODE              := 'LOAD_TEST';                             -- JOB을 구별하기 위한 고유 STRING, MAX (15 Bytes)      
    in_RUN_SOURCE            := 'STS';                                   -- 'STS' or 'AWR' (Reserved KEY로 STS 또는 AWR이어야 함) 
    in_DESCRIPTION           := 'LOAD_TEST';                             -- JOB Description
    in_PARALLEL_PROC         := 3;                                       -- Parallel Process (동시 처리를 위한 병렬도) 
    in_RUN_NODE_LIST         := NULL;                                    -- RAC Node에서 특별히 지정된 Node LIst에서 실행하도록 설정, RAC Node번호 (NULL-현재 접속 Node에서만 실행, '1,2,3' - 1 -> 2 -> 3번 Node에서 Round robin방식으로 실행, Main Control은 첫번쨰 지정 Node)
    in_RUN_SQL_TIMEOUT       := 0;                                       -- SQL 실행 Timeout (Sec)
    in_RUN_REMAP_STRING      := NULL;                                    -- REMAP STring : 'EMP:EMP_$T,DEPT:DEPT_$T,EMP_PK:EMP_PK_$T'
    in_RUN_REPLACE_SYSDATE   := NULL;                                    -- SYSDATE, SYSTIMESTAMP를 지정한 날짜로 변경하여 실행 (FORMAT : YYYYMMDDHH24MISS)
    in_RUN_NLS_DATE_FORMAT   := 'YYYY-MM-DD HH24:MI:SS';                 -- SQL들이 날짜 Type에 대해 String으로 지정할 경우 사용될 Date Format, NULL --> 'YYYY-MM-DD HH24:MI:SS'
    in_RUN_PRE_SQL           := NULL;                                    -- 위의 설명과 같이 SQL실행전 환경 설정을 위한 Pre SQL
    in_RUN_POST_SQL          := NULL;                                    -- Post SQL, ;로 구분한 여러 SQL문장 
    in_PRE_PLAN_COMPARE_YN   := 'N';                                     -- Repository의 수집 SQL과 PLAN (EXPLAIN PLAN)비교 후 같은 PLAN여부 확인 Y/N, Y일 경우 PLAN비교 
    in_PLAN_COMP_CHK_RUN_YN  := 'Y';                                     -- Repository의 수집 SQL과 PLAN (EXPLAIN PLAN)비교 후 다를 경우 SPT로 SQL실행 여부 Y/N, N일 경우 PLAN만 비교  
                             
    in_USE_SQL_REPLACE_YN    := 'Y';                                     -- EPLACE SQL_TEXT to 튜닝 SQL_TEXT on ILM_IRPMSPT_SQL_REPLACE Table  
    in_USE_BIND_REPLACE_YN   := 'N';                                     -- BIND Value Replace Y/N
    
    in_LOAD_TEST_YN          := 'Y';                                     -- SPT Load Test Y or N
    in_LOAD_PROC_TYPE        := 'C';                                     -- C or O : C(sql_id에 한시점에 여러 Process들이 동시 실행가능, Timeout가능 사용불가),O(sql_id에 한 시점에 한개의 Process만 실행가능, Timeout기능 가능)
    in_LOAD_PROC_THINKTIME   := NULL;                                    -- 부하발생시 Thinktime (Sleeptime between SQLs) 1/100초 단위 (0.01 ~ ) 단위 초 
    
    in_USE_QUERY_RESULT_CHK  := 'N';                                     -- Query Result 비교목적 DBMS_SQLHASH를 이용한 SQL결과 저장 
    in_USE_QUERY_RESULT_LOG  := 'N';                                     -- Query Result 비교목적 DBMS_SQLHASH를 이용한 RUN SQL Logging in ILM_IRPMSPT_DIGITALSLOG
    in_USE_QUERY_RESULT_ROWLIMIT := 0;                                   -- Query Result 비교목적 Result결과의 HASH처리 LIMIT (100000 ROW 이상일 경우 시간이 늘어남, 10만 ROW일 경우 1분정도 소요)
    
    in_PREFETCH_COUNT        := -1 ;                                     -- Select Query Prefetch Count, PREFETCH_COUNT = -1 (1 ROW FETCH) , FETCH_COUNT = 0 (계산된 FETCH) , FETCH_COUNT > 0  : (FIXED FETCH)
    in_USE_SQL_COMMENT       := 'Y';                                     -- SQL에 Comment를 붙여 실행 (고유한 실행 목적, COMMENT제거('N')일 경우 SQL Plan Baseline, SQL Profile적용 후 사용여부 Check목적         
    -- -----------------------------------------------------------------------------------------------------------------------------------------
    -- Table 구조분석을 위한 OWNER.TABLE_NAME에 속한 SQL문장들만 찾아서 SPT를 싱행하기 위해서 아래 설정
    -- Migration과 환경을 위한 전체 SQL SPT실행을 위해서는 in_TABLE_OWNER, in_TABLE_NAME NULL 지정
    -- -----------------------------------------------------------------------------------------------------------------------------------------
    in_TABLE_OWNER           := 'SOE';                                   -- AWR, STS 대상에서 특별히 지정된 TABLE을 찿고자 할 경우 , OWNER 
    in_TABLE_NAME            := 'ORDERS';                                -- AWR, STS 대상에서 특별히 지정된 TABLE을 찿고자 할 경우 , TABLE_NAME 
    
    IF in_RUN_SOURCE = 'STS' AND in_TABLE_OWNER IS NOT NULL AND in_TABLE_NAME IS NOT NULL THEN   -- OWNER,TABLE_NAME이 지정된 경우 해당 Table의 Object들을 참조하는 SQL문장들만 추출
       in_TABLE_OWNER := TRIM(in_TABLE_OWNER);
       in_TABLE_NAME  := TRIM(in_TABLE_NAME);
       
       in_PREDICATE :=' AND COMMAND_TYPE IN (2,3,6,7,189) ' || 
                      ' AND PARSING_SCHEMA_NAME NOT IN (''APEX_030200'',''CTXSYS'',''DBSNMP'',''EXFSYS'',''MAXGAUGE'',''MDSYS'',''ORACLE_OCM'',
                                                        ''STRMADMIN'',''SYS'',''SYSTEM'',''WMSYS'') ' ||
                      ' AND (NAME , OWNER, SQL_ID) IN   
                        (select /*+ UNNEST QB_NAME(SUB1) HASH_SJ */ distinct NAME , OWNER, SQL_ID FROM (select NAME , OWNER, SQL_ID
                         from   ' || in_STS_TABLE_NAME || '  where  (plan_object_owner , plan_object_name)  in
                                (select ''' || in_TABLE_OWNER || ''' object_owner, ''' || in_TABLE_NAME || ''' object_name from dual union all
                                 select owner object_owner, index_name object_name from dba_indexes
                                 where table_owner = ''' || in_TABLE_OWNER || ''' and table_name = ''' || in_TABLE_NAME || ''')
                       /* -----------------------------------------------------------------------------------------------------
                         union all  select NAME , OWNER, SQL_ID  from   ' || in_STS_TABLE_NAME || '
                         where  COMMAND_TYPE = 2 and REGEXP_INSTR(upper(SQL_TEXT), ''[^[:alpha:]]INTO[^[:alpha:]]+'' || ''' || 
                         in_TABLE_NAME || ''' || ''\W'' ) > 1  
                       -------------------------------------------------------------------------------------------------------*/
                         )) '  ;
    ELSE
       in_PREDICATE :=' AND COMMAND_TYPE IN (2,3,6,7,189) ' || 
                      ' AND PARSING_SCHEMA_NAME NOT IN (''APEX_030200'',''CTXSYS'',''DBSNMP'',''EXFSYS'',''MAXGAUGE'',''MDSYS'',''ORACLE_OCM'',
                                                        ''STRMADMIN'',''SYS'',''SYSTEM'',''WMSYS'') '   ;
    END IF;
    -- -----------------------------------------------------------------------------------------------------------------------------------------
    
    -- #####################################################################################################################################################
    
    -- JOB_CODE는 초대 15 Byte
    in_JOB_CODE := SUBSTR(UPPER(TRIM(NVL(in_JOB_CODE,'JOB'))),1,15);   
    
    
    -- STEP 1: WORK TABLE및 LOG Table TRUNCATE (Option) -------------------------------------------------------------
    -- EXECUTE IMMEDIATE 'TRUNCATE TABLE ' || in_SPT_LOGTBL_OWNER  || '.' || in_SPT_LOGTBL_NAME; 
    -- EXECUTE IMMEDIATE 'TRUNCATE TABLE ' || in_SPT_WORKTBL_OWNER || '.' || in_SPT_WORKTBL_NAME; 
    -- WORK TABLE및 LOG Table TRUNCATE ------------------------------------------------------------------------------
    
    
    -- STEP 2: 기존 Running Job이 있다면 DROP Job (Option) --------------------------------------------------------------
    -- FOR v_II in 1 .. in_PARALLEL_PROC LOOP
    --  BEGIN
    --    dbms_scheduler.stop_job(job_name=> 'IRPMSPT_' || in_JOB_CODE || '_' || TRIM(TO_CHAR(v_II,'009')));
    --    EXCEPTION WHEN others THEN 
    --       v_code := SQLCODE;
    --       v_errm := SQLERRM;
    --       DBMS_OUTPUT.PUT_LINE ('iRPM : ' || 'DROP JOB : ' || 'IRPMSPT_' || in_JOB_CODE || '_' || TRIM(TO_CHAR(v_II,'009')) || ' Error ('  || v_code || ': ' || v_errm);          
    --  END;
    --END LOOP;
    -- 기존 Running Job이 있다면 DROP Job -------------------------------------------------------------------------------
    
    IRPM_SPT.INIT(in_LICENSE_KEY); 

    -- STEP 3: MAIN IRPM SPT Play(SQL Run)를 위한 초기 구성  -------------------------------------------------------------
    IF in_RUN_SOURCE = 'STS' THEN
        IRPM_SPT.SPT_INIT_FROM_STS(in_SPT_WORKTBL_OWNER,in_SPT_WORKTBL_NAME,in_JOB_CODE, in_STS_OWNER, in_STS_TABLE_NAME, out_RUN_NAME ,in_PREDICATE );
    ELSIF in_RUN_SOURCE = 'AWR' THEN         
        --in_AWR_SQLTARGET_DAYS로 지정할 경우  
        --IRPM_SPT.SPT_INIT_FROM_AWR(in_SPT_WORKTBL_OWNER,in_SPT_WORKTBL_NAME,in_JOB_CODE, in_AWR_SQLTARGET_DAYS, out_RUN_NAME ,in_PREDICATE );   
        IF in_TABLE_OWNER IS NOT NULL AND in_TABLE_NAME IS NOT NULL THEN 
           IRPM_SPT.SPT_INIT_FROM_AWR2(in_SPT_WORKTBL_OWNER, in_SPT_WORKTBL_NAME, in_JOB_CODE,  in_AWR_STARTDT, in_AWR_ENDDT, NULL , out_RUN_NAME  , in_PREDICATE )  ;    
        ELSE
           IRPM_SPT.SPT_INIT_FROM_AWR2(in_SPT_WORKTBL_OWNER, in_SPT_WORKTBL_NAME, in_JOB_CODE,  in_AWR_STARTDT, in_AWR_ENDDT, in_TABLE_OWNER || '.' || in_TABLE_NAME , out_RUN_NAME  , in_PREDICATE )  ; 
        END IF; 
    END IF;         
    -- MAIN IRPM SPT Play(SQL Run)를 위한 초기 구성  ---------------------------------------------------------------------
    
    
    -- STEP 4: RUN Configuration (ILM_IRPMSPT_RUNINFO Table에 등록)----------------------------------------------------
    IRPM_SPT.RUN_CONFIG(out_RUN_NAME,in_RUN_SOURCE,in_DESCRIPTION,in_PARALLEL_PROC,in_RUN_SQL_TIMEOUT, in_RUN_REMAP_STRING, in_RUN_REPLACE_SYSDATE,
                        in_RUN_NLS_DATE_FORMAT,in_RUN_PRE_SQL,in_RUN_POST_SQL,in_PRE_PLAN_COMPARE_YN, in_PLAN_COMP_CHK_RUN_YN, 
                        in_USE_SQL_REPLACE_YN , in_USE_BIND_REPLACE_YN, in_LOAD_TEST_YN , in_LOAD_PROC_TYPE, in_LOAD_PROC_THINKTIME,
                        in_USE_QUERY_RESULT_CHK,in_USE_QUERY_RESULT_LOG,in_USE_QUERY_RESULT_ROWLIMIT, in_PREFETCH_COUNT, in_USE_SQL_COMMENT);
    
    -- STEP 5: IRPM SPT Play(SQL Run) 내부적으로 병렬도 만큼 Scheduler Job이 디동됨 'IRPMSPT_' || in_JOB_CODE || TRIM(TO_CHAR(v_II) --   
    --         in_LOAD_TEST_YN = 'Y' ==> 부하발생기 JOB , 'N' ==> SPT Job
    --         부하발생기는 iRPM_SPT.SPT_LOAD_START로 START해 줘야 부하 JOB STart 
    IF in_LOAD_TEST_YN = 'Y' THEN
        IRPM_SPT.SPT_LOAD_JOB(in_SPT_WORKTBL_OWNER,in_SPT_WORKTBL_NAME,in_JOB_CODE, in_STS_OWNER, in_STS_TABLE_NAME, out_RUN_NAME, in_RUN_SOURCE, in_PARALLEL_PROC, in_RUN_NODE_LIST);
        -- Remove Comment Line for Immediately Start Load Test
        -- iRPM_SPT.SPT_LOAD_START (out_RUN_NAME, in_RUN_SOURCE);
        -- Remove Comment Line for Reserved Time (다음의 경우는 1분뒤에 자동 START하며 10분간 부하 발생)
        -- iRPM_SPT.SPT_LOAD_START (out_RUN_NAME, in_RUN_SOURCE, SYSDATE + 1/(24*60) , SYSDATE + 11/(24*60) ); 
    ELSE
        IRPM_SPT.SPT_START_JOB(in_SPT_WORKTBL_OWNER,in_SPT_WORKTBL_NAME,in_JOB_CODE, in_STS_OWNER, in_STS_TABLE_NAME, out_RUN_NAME, in_RUN_SOURCE, in_PARALLEL_PROC, in_RUN_NODE_LIST);
    END IF;
 
    
    DBMS_OUTPUT.PUT_LINE(out_RUN_NAME);
END;
/

 
-- ==========================================================================================================================================   
-- SPT Run STatistics Information , RUN Configuration Check
-- ========================================================================================================================================== 
SELECT RUN_NAME,RUN_SOURCE,DECODE(LOAD_TEST_YN,'Y','Load Tester','SPT') "Run Type", DESCRIPTION "Description",
       DECODE(RUN_END_DATE,NULL,DECODE(PROC_REST,0,'N/A','Running...'),'Finished') "Run Status",RUN_START_DATE "Job Start Date",RUN_END_DATE "Job End Date",
       -- Run STatistics Information
       TOT_CNT "Target SQL Cnt",PROC_FINISH "Finished SQL Cnt",PROC_REST "Rest SQL Cnt",PROC_PCT "Progress %",
       PROC_P "Running SQL Cnt",PROC_N "Not Run Yet ",PROC_T "Timeout SQL Cnt",PROC_E "Error SQL Cnt",PROC_S "Skip SQL Cnt",PROC_Y "Run OK Cnt",
       PROC_FINISH "Total Runned SQL Cnt", ROUND(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))) "Load Duration(Sec)",
       ROUND(DECODE(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60)),0,0,NULL,0,PROC_FINISH/((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))),2) TPS, 
       -- Configuration Information
       RUN_PROCESS,RUN_SQL_TIMEOUT,RUN_REMAP_STRING,
       RUN_REPLACE_SYSDATE,RUN_NLS_DATE_FORMAT,RUN_PRE_SQL,RUN_POST_SQL,PLAN_COMPARE_YN,PLAN_COMPARE_CHK_RUN_YN,
       USE_SQL_REPLACE,USE_BIND_REPLACE,
       LOAD_REG_DATE,LOAD_TEST_YN,LOAD_PROC_STATUS,LOAD_PROC_THINKTIME,LOAD_PROC_STARTTIME,LOAD_PROC_ENDTIME ,LOAD_PROC_COMMIT_YN,  LOAD_PROC_TYPE,
       USE_QUERY_RESULT_CHK , USE_QUERY_RESULT_LOGGING, USE_QUERY_RESULT_ROWLIMIT, USE_SQL_COMMENT, PREFETCH_COUNT              
FROM ILM_IRPMSPT_RUNINFO
WHERE 1=1
-- AND RUN_NAME like 'ORDERS%'
-- ORDER BY COALESCE(RUN_START_DATE,LOAD_REG_DATE) DESC;
ORDER BY SUBSTR(RUN_NAME,-14) DESC;



--RUN_NAME                  RUN_SOURCE  Run Type     Description    Run Status  Job Start Date       Job End Date         Target SQL Cnt   Finished SQL Cnt    Rest SQL Cnt    Progress %    Running SQL Cnt    Not Run Yet    Timeout SQL Cnt  Error SQL Cnt  Skip SQL Cnt   Run OK Cnt   Total Runned SQL Cnt   Load Duration(Sec)   TPS	   ...
--------------------------- ----------- ------------ -------------- ----------- -------------------- -------------------- ---------------- ------------------- --------------- ------------- ------------------ -------------- ---------------- -------------- -------------- ------------ ---------------------- -------------------- ------
--LOAD_TEST_20190824213445  STS         Load Tester  LOAD_TEST      Running...											...



-- =============================================================================================================================================
-- 부하발생기 JOB Start  : 위에서 나온 가장 처음 대상의 RUN_NAME이 START대상임 (START를 하지 않으면 SQL이 실행 안됨 - 부하 START)
--    아래 'LOAD_TEST_20190824213445'은 RUN_NAME으로 바꿔줘야 함
--    다음은 1분 뒤에 START하여 11분 뒤에 끝나도록 설정 (10분간 부하 발생 예)
-- =============================================================================================================================================
BEGIN iRPM_SPT.SPT_LOAD_START ('LOAD_TEST_20190824213445', 'STS', SYSDATE + 1/(24*60) , SYSDATE + 11/(24*60) ,'N' ); END;
/
 

-- =============================================================================================================================================
-- 부하발생기 진행상태 확인
-- =============================================================================================================================================
SELECT RUN_NAME,RUN_SOURCE,DECODE(LOAD_TEST_YN,'Y','Load Tester','SPT') "Run Type", DESCRIPTION "Description",
       DECODE(RUN_END_DATE,NULL,DECODE(PROC_REST,0,'N/A','Running...'),'Finished') "Run Status",RUN_START_DATE "Job Start Date",RUN_END_DATE "Job End Date",
       -- Run STatistics Information
       TOT_CNT "Target SQL Cnt",PROC_FINISH "Finished SQL Cnt",PROC_REST "Rest SQL Cnt",PROC_PCT "Progress %",
       PROC_P "Running SQL Cnt",PROC_N "Not Run Yet ",PROC_T "Timeout SQL Cnt",PROC_E "Error SQL Cnt",PROC_S "Skip SQL Cnt",PROC_Y "Run OK Cnt",
       PROC_FINISH "Total Runned SQL Cnt", ROUND(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))) "Load Duration(Sec)",
       ROUND(DECODE(((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60)),0,0,NULL,0,PROC_FINISH/((NVL(RUN_END_DATE,SYSDATE)- RUN_START_DATE)*(24*60*60))),2) TPS, 
       -- Configuration Information
       RUN_PROCESS,RUN_SQL_TIMEOUT,RUN_REMAP_STRING,
       RUN_REPLACE_SYSDATE,RUN_NLS_DATE_FORMAT,RUN_PRE_SQL,RUN_POST_SQL,PLAN_COMPARE_YN,PLAN_COMPARE_CHK_RUN_YN,
       USE_SQL_REPLACE,USE_BIND_REPLACE,
       LOAD_REG_DATE,LOAD_TEST_YN,LOAD_PROC_STATUS,LOAD_PROC_THINKTIME,LOAD_PROC_STARTTIME,LOAD_PROC_ENDTIME ,LOAD_PROC_COMMIT_YN,  LOAD_PROC_TYPE,
       USE_QUERY_RESULT_CHK , USE_QUERY_RESULT_LOGGING, USE_QUERY_RESULT_ROWLIMIT, USE_SQL_COMMENT, PREFETCH_COUNT                 
FROM ILM_IRPMSPT_RUNINFO
WHERE 1=1
-- AND RUN_NAME like 'ORDERS%'
-- ORDER BY COALESCE(RUN_START_DATE,LOAD_REG_DATE) DESC;
ORDER BY SUBSTR(RUN_NAME,-14) DESC;


--RUN_NAME                  RUN_SOURCE  Run Type     Description    Run Status  Job Start Date       Job End Date         Target SQL Cnt   Finished SQL Cnt    Rest SQL Cnt    Progress %    Running SQL Cnt    Not Run Yet    Timeout SQL Cnt  Error SQL Cnt  Skip SQL Cnt   Run OK Cnt   Total Runned SQL Cnt   Load Duration(Sec)   TPS	   ...
--------------------------- ----------- ------------ -------------- ----------- -------------------- -------------------- ---------------- ------------------- --------------- ------------- ------------------ -------------- ---------------- -------------- -------------- ------------ ---------------------- -------------------- ------
--LOAD_TEST_20190824213445  STS         Load Tester  LOAD_TEST      Running...  2019/08/24 21:34:58                       123              82                  122             66.7          0                  122            0                1              0              81           82                     7                    11.71  ...


-- =============================================================================================================================================
