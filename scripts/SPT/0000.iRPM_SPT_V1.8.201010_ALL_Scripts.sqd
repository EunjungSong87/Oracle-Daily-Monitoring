--BEGIN 
--    IRPM_SQLGATHER_REMOTE('EORCL12C1','ORCL12C',1000,'IRPMSPT','ILM_IRPMSPT_SQLSET_STAGE', 5000,'  AND S.EXECUTIONS > 1 AND S.LAST_ACTIVE_TIME >= to_date(to_char(sysdate - 2.2/24,''yyyy/mm/dd hh24:mi:ss''),''yyyy/mm/dd hh24:mi:ss'')  ');
--END;
